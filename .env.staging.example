# ─────────────────────────────────────────────────────────────────────────────
# PioAssets — STAGING environment. Copy to .env.staging on the server.
#
# Everything that could reach a real person is off, and off in a way that cannot
# be switched on by accident:
#
#   MAIL_PROVIDER=mock   is NOT sufficient on its own. RoutingMailProvider
#                        prefers the mail_settings row in the database, so the
#                        scrub deletes it. Both are required.
#   PUSH_PROVIDER=mock   IS sufficient: push reads only the environment, and the
#                        Firebase key is not mounted into the staging container.
#
# NEVER commit .env.staging. Use DIFFERENT secrets from production - a staging
# box that shares production's JWT secret is a way into production.
# ─────────────────────────────────────────────────────────────────────────────

DOMAIN=staging.pioassets.com
PUBLIC_URL=https://staging.pioassets.com

NODE_ENV=production
API_PORT=3001
API_URL=https://staging.pioassets.com
WEB_URL=https://staging.pioassets.com
CORS_ORIGINS=https://staging.pioassets.com

# ── Database — its own, with "staging" in the name ───────────────────────────
# The name is load-bearing: both scrub guards refuse a database without it.
POSTGRES_USER=techpioasset
POSTGRES_PASSWORD=CHANGE_ME_different_from_production
POSTGRES_DB=techpioasset_staging
DATABASE_URL=postgresql://techpioasset:CHANGE_ME_different_from_production@postgres:5432/techpioasset_staging

REDIS_URL=redis://redis:6379
QUEUE_PROVIDER=bullmq
CACHE_PROVIDER=redis
RATE_LIMIT_STORAGE=redis

# ── Secrets — generate fresh ones (openssl rand -base64 48) ──────────────────
# Do not copy these from .env.prod.
JWT_ACCESS_SECRET=CHANGE_ME_staging_access_secret_min_32_chars
JWT_REFRESH_SECRET=CHANGE_ME_staging_refresh_secret_min_32_chars
MFA_ENCRYPTION_KEY=CHANGE_ME_staging_mfa_key_min_32_chars

# ── Nothing leaves this machine ──────────────────────────────────────────────
MAIL_PROVIDER=mock
MAIL_FROM=PioAssets Staging <no-reply@staging.invalid>
PUSH_PROVIDER=mock
AI_PROVIDER=mock
AI_ENABLED=false

STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=.local-storage

# Off by default: the warranty/maintenance sweep would generate notifications
# against a copy of real data on every timer. Turn it on deliberately when that
# is the thing being tested.
ENABLE_SCHEDULED_JOBS=false

LOG_LEVEL=debug
