.turbo/

# env - .env.example is committed, real env files are never
.env
.env.local
.env.*.local
.env.prod
!.env.example
!.env.prod.example

# local infra + generated artefacts
.pnpm-store/
prisma/generated/
*.tsbuildinfo
.expo/
.expo-shared/

# `expo prebuild` output. The mobile app is a managed-workflow project, so these
# are regenerated from app.json rather than edited - committing them means edits
# there are silently discarded on the next prebuild.
apps/mobile/android/
apps/mobile/ios/

# test output
playwright-report/
test-results/
blob-report/

# local mock provider output (mock mail/storage writes here)
.local-storage/
.local-mail/

# user-space PostgreSQL cluster created by `pnpm db:local`
.local-db/

# Source requirements document. Kept local and out of the public repository;
# PLAN.md carries everything needed to work on the codebase.
TechpioAsset Design and Development Plan.pdf

# editors / OS
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
*.log
npm-debug.log*
pnpm-debug.log*

# Real staff names/emails extracted from HR sheets - never committed.
apps/api/scripts/import-real-data.json
apps/api/scripts/sync-gadget-update.json

# Firebase config is supplied on the build server, never committed
apps/mobile/google-services.json
