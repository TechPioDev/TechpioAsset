          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(pg_stat_database_blks_hit{job=\"postgres\",env=\"$env\"}[10m])) / (sum(rate(pg_stat_database_blks_hit{job=\"postgres\",env=\"$env\"}[10m])) + sum(rate(pg_stat_database_blks_read{job=\"postgres\",env=\"$env\"}[10m])))",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "id": 5
