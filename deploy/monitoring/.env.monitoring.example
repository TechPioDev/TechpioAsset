# Monitoring stack settings. setup.sh generates the real .env.monitoring (git-
# ignored, mode 600) with random passwords; this file only documents the keys.

# Public host Grafana is served from, under /grafana/ (used for links and cookies).
GRAFANA_PUBLIC_HOST=pioassets.com
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# Read-only Postgres role used by postgres_exporter. setup.sh creates it in
# each database with these passwords and fills in the database names.
MONITOR_DB_USER=techpioasset_monitor
MONITOR_DB_PASSWORD_PROD=CHANGE_ME
MONITOR_DB_PASSWORD_STAGING=CHANGE_ME
MONITOR_DB_NAME_PROD=techpioasset
MONITOR_DB_NAME_STAGING=techpioasset

# Alert delivery. Alerts evaluate and show in Grafana regardless; email needs
# all of these. Any SMTP works (Microsoft 365: smtp.office365.com:587 with an
# app password, or a mailbox allowed to SMTP AUTH).
ALERT_EMAIL=
GRAFANA_SMTP_ENABLED=false
GRAFANA_SMTP_HOST=smtp.example.com:587
GRAFANA_SMTP_USER=
GRAFANA_SMTP_PASSWORD=
GRAFANA_SMTP_FROM=monitoring@example.com
