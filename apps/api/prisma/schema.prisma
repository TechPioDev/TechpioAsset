/// Spec section 21 - audited actions.
enum AuditAction {
  LOGIN
  LOGIN_FAILED
  LOGOUT
  PASSWORD_RESET
  MFA_ENROLLED
  MFA_DISABLED
  USER_CREATED
  USER_UPDATED
  ROLE_CHANGED
  PERMISSION_CHANGED
  ASSET_CREATED
  ASSET_UPDATED
  ASSET_STATUS_CHANGED
  ASSET_COST_CHANGED
  ASSIGNMENT_CREATED
  ASSIGNMENT_RETURNED
  // v2.15 - an employee confirming a device reached them. The receipt is the
  // point of the acknowledgement, so it belongs in the immutable log.
  RECEIPT_ACKNOWLEDGED
  ASSET_TRANSFERRED
  INVENTORY_ADJUSTED
  INVOICE_UPLOADED
  INVOICE_UPDATED
  INVOICE_ARCHIVED
  AI_PROCESSING
  AI_CORRECTION
  VERIFICATION_APPROVED
  VERIFICATION_REJECTED
  REQUEST_SUBMITTED
  REQUEST_APPROVED
  REQUEST_REJECTED
  REQUEST_REVIEW_STARTED
  DISPOSAL_RECORDED
  DATA_EXPORTED
  SETTING_CHANGED
  DOCUMENT_DOWNLOADED
  // v2.3 licenses. ASSIGN_BLOCKED is the flagship: refused 11th seats leave a trail.
  LICENSE_CREATED
  LICENSE_UPDATED
  LICENSE_ASSIGNED
  LICENSE_REVOKED
  LICENSE_RENEWED
  LICENSE_KEY_REVEALED
  LICENSE_ASSIGN_BLOCKED
  LICENSE_TRANSFERRED
  // v2.4 procurement
  PR_SUBMITTED
  PR_APPROVED
  PR_REJECTED
  PO_ISSUED
  PO_CANCELLED
  GRN_RECEIVED

  // v2.9 C2 - budgets. Committing and releasing move real money commitments,
  // so both are audited with the figures involved.
  COST_CENTRE_CREATED
  COST_CENTRE_UPDATED
  BUDGET_CREATED
  BUDGET_UPDATED
  BUDGET_COMMITTED
  BUDGET_RELEASED
  PR_CANCELLED

  // v2.9 C3 - competitive quoting. The award carries a reason, so the audit
  // row is the answer to "why this vendor at this price?".
  RFQ_CREATED
  RFQ_QUOTE_RECORDED
  RFQ_AWARDED
  RFQ_CANCELLED

  // v2.9 C4 - lots and expiry. Issuing expired stock is always audited, with
  // the reason somebody gave for doing it.
  STOCK_BATCH_RECEIVED
  STOCK_EXPIRED_ISSUED
  MATCH_OVERRIDDEN
  // v2.5 discovery
  DISCOVERY_INGESTED
  DISCOVERY_REVIEWED
  // v2.5 work orders
  WORK_ORDER_ESCALATED
  // v2.7 export audit (AUD-009)
  REPORT_EXPORTED
  // v2.6 platform plane
  TENANT_CREATED
  TENANT_SUSPENDED
  TENANT_ACTIVATED
}

