// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum VerificationPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  /// v2.12 - invitation links. Long-lived (7 days), single use; accepting one
  /// sets the password, verifies the email and activates the account.
  INVITE
}

/// v2.22 - who may raise a request, company-wide.
enum RequestCreationPolicy {
  /// Anyone holding requests:create, which is every employee by default.
  EVERYONE
  /// Only people who raise on behalf of others (HR, IT) and settings managers.
  ADMINS_ONLY
}

enum TrackingType {
  INDIVIDUAL
  QUANTITY
}

