// ─────────────────────────────────────────────────────────────────────────────
// Identity and access
// ─────────────────────────────────────────────────────────────────────────────

model Company {
  /// v2.22 - request-raising policy for the whole tenant.
  requestPolicy       RequestCreationPolicy @default(EVERYONE)
  id                  String                @id @default(cuid())
  name                String
  legalName           String?
  taxId               String?
  baseCurrency        String                @default("USD") @db.Char(3)
  locale              String                @default("en-US")
  timezone            String                @default("UTC")
  logoKey             String?
  isActive            Boolean               @default(true)
  /// v2.12 - Teams/Slack incoming-webhook for high-signal operational alerts.
  teamAlertWebhookUrl String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  users                     User[]
  offices                   Office[]
  deviceAgents              DeviceAgent[]
  departments               Department[]
  categories                Category[]
  assets                    Asset[]
  inventoryItems            InventoryItem[]
  vendors                   Vendor[]
  invoices                  Invoice[]
  purchaseOrders            PurchaseOrder[]
  requests                  AssetRequest[]
  roles                     Role[]
  auditLogs                 AuditLog[]
  notifications             Notification[]
  attachments               Attachment[]
  aiConfiguration           AIConfiguration?
  aiUsageRecords            AIUsageRecord[]
  workflowDefinitions       WorkflowDefinition[]
  onboardingTemplates       OnboardingTemplate[]
  savedFilters              SavedFilter[]
  scheduledReports          ScheduledReport[]
  physicalInventorySessions PhysicalInventorySession[]
  approvalDelegations       ApprovalDelegation[]
  softwareLicenses          SoftwareLicense[]
  purchaseRequests          PurchaseRequest[]
  goodsReceipts             GoodsReceipt[]
  stockLocations            StockLocation[]
  costCentres               CostCentre[]
  budgets                   Budget[]
  stockBatches              StockBatch[]
  quoteRequests             QuoteRequest[]
  quotes                    Quote[]
  catalogItems              CatalogItem[]

  emailTemplates        EmailTemplate[]
  notificationRules     NotificationRule[]
  emailLogs             EmailLog[]
  requestAssessments    RequestAssessment[]
  vendorProducts        VendorProduct[]
  vendorProductImages   VendorProductImage[]
  vendorProductReviews  VendorProductReview[]
  procurementSelections ProcurementSelection[]
  categorySpecFields    CategorySpecField[]
  qualityChecks         QualityCheck[]

  @@index([deletedAt])
  @@map("companies")
}

model User {
  /// v2.42 - set only on external supplier users, and the thing that decides
  /// whose rows they can touch. The VENDOR role says "may manage a catalogue";
  /// this says whose. A vendor user without it is a bug, and the services treat
  /// it as one rather than falling back to "all vendors".
  vendorId String?

  id        String @id @default(cuid())
  companyId String

  email        String
  passwordHash String?
  status       UserStatus @default(INVITED)

  emailVerifiedAt DateTime?
  /// Encrypted at rest by the application before persistence; never returned by any endpoint.
  mfaSecret       String?
  mfaEnabledAt    DateTime?

  /// Brute-force protection (spec section 20).
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?

  /// Optional Microsoft Entra ID subject claim for SSO users.
  externalIdpSubject String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?
  version     Int       @default(0)

  company Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  profile UserProfile?
  roles   UserRole[]

  refreshTokens            RefreshToken[]
  verificationTokens       VerificationToken[]
  deviceTokens             DeviceToken[]
  assignedAssets           Asset[]                    @relation("AssetCurrentAssignee")
  ownedCostCentres         CostCentre[]               @relation("CostCentreOwner")
  assignmentsHeld          AssetAssignment[]          @relation("AssignmentHolder")
  assignmentsGranted       AssetAssignment[]          @relation("AssignmentGrantedBy")
  returnsReceived          AssetReturn[]              @relation("ReturnReceivedBy")
  transfersFrom            AssetTransfer[]            @relation("TransferFromUser")
  transfersTo              AssetTransfer[]            @relation("TransferToUser")
  transfersApproved        AssetTransfer[]            @relation("TransferApprovedBy")
  transfersReceived        AssetTransfer[]            @relation("TransferReceivedBy")
  requestsRaised           AssetRequest[]             @relation("RequestRequester")
  requestsOnBehalf         AssetRequest[]             @relation("RequestBeneficiary")
  requestsManaged          AssetRequest[]             @relation("RequestManager")
  approvals                RequestApproval[]          @relation("ApprovalApprover")
  reviewedApprovals        RequestApproval[]          @relation("ApprovalReviewer")
  requestComments          RequestComment[]
  invoicesReviewed         Invoice[]                  @relation("InvoiceReviewer")
  invoiceDocumentsUploaded InvoiceDocument[]          @relation("DocumentUploader")
  verificationsDecided     InvoiceVerification[]      @relation("VerificationDecider")
  notifications            Notification[]
  notificationPreferences  NotificationPreference[]
  auditLogs                AuditLog[]                 @relation("AuditActor")
  aiUsageRecords           AIUsageRecord[]
  disposalsApproved        DisposalRecord[]           @relation("DisposalApprover")
  onboardingTasks          OnboardingTask[]           @relation("OnboardingSubject")
  maintenanceRequested     MaintenanceRecord[]        @relation("MaintenanceRequester")
  inventoryTransactions    InventoryTransaction[]     @relation("InventoryActor")
  physicalInventoryScans   PhysicalInventoryScan[]    @relation("ScanBy")
  physicalInventoryLed     PhysicalInventorySession[] @relation("SessionOwner")
  savedFilters             SavedFilter[]
  scheduledReports         ScheduledReport[]
  directReports            UserProfile[]              @relation("LineManager")
  headedDepartments        Department[]               @relation("DepartmentHead")
  delegationsGiven         ApprovalDelegation[]       @relation("DelegationDelegator")
  delegationsReceived      ApprovalDelegation[]       @relation("DelegationDelegate")
  licenseAssignments       LicenseAssignment[]        @relation("LicenseAssignee")
  purchaseRequests         PurchaseRequest[]          @relation("PurchaseRequester")
  qualityChecks            QualityCheck[]             @relation("QualityInspector")
  requestAssessments       RequestAssessment[]        @relation("AssessmentAssessor")
  vendorProductReviews     VendorProductReview[]      @relation("VendorProductReviewer")
  procurementSelections    ProcurementSelection[]     @relation("ProcurementSelector")
  vendorAccount            Vendor?                    @relation("VendorPortalUsers", fields: [vendorId], references: [id], onDelete: Restrict)

  /// Email is unique per tenant, not globally: the same person may exist in two companies.
  @@unique([companyId, email])
  @@index([companyId, status])
  @@index([externalIdpSubject])
  @@index([deletedAt])
  @@index([companyId, vendorId])
  @@map("users")
}

model UserProfile {
  /// v2.22 - per-person override of the company request policy.
  /// null follows the policy; true always allows; false always blocks.
  canRaiseRequests Boolean?
  id               String   @id @default(cuid())
  userId           String   @unique

  firstName       String
  lastName        String
  displayName     String?
  employeeNumber  String?
  jobTitle        String?
  phone           String?
  /// Object-storage key. Served only via a signed URL; never a public path.
  avatarKey       String?
  hireDate        DateTime?
  terminationDate DateTime?

  /// v2.12 - personal display preferences the user manages themselves.
  /// Null means "follow the company/browser default"; they never affect access.
  locale     String?
  timezone   String?
  dateFormat String?

  departmentId String?
  officeId     String?
  managerId    String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  office     Office?     @relation(fields: [officeId], references: [id], onDelete: SetNull)
  manager    User?       @relation("LineManager", fields: [managerId], references: [id], onDelete: SetNull)

  @@index([departmentId])
  @@index([officeId])
  @@index([managerId])
  @@index([employeeNumber])
  @@map("user_profiles")
}

model Role {
  id          String  @id @default(cuid())
  companyId   String
  key         String
  name        String
  description String?
  /// System roles are seeded and may not be deleted, only re-granted.
  isSystem    Boolean @default(false)
  /// Auditor is read-only: the API refuses to attach a write permission to it.
  isReadOnly  Boolean @default(false)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  company       Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  permissions   RolePermission[]
  users         UserRole[]
  workflowSteps WorkflowStep[]    @relation("StepApproverRole")
  approvalSteps RequestApproval[] @relation("ApprovalApproverRole")

  @@unique([companyId, key])
  @@index([deletedAt])
  @@map("roles")
}

model Permission {
  id          String  @id @default(cuid())
  /// `resource:action`, e.g. `assets:assign`. Global, not per-tenant.
  key         String  @unique
  resource    String
  action      String
  description String?
  /// Read-only permissions are the only ones grantable to a read-only role.
  isReadOnly  Boolean @default(false)

  createdAt DateTime @default(now())

  roles RolePermission[]

  @@index([resource])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  createdAt   DateTime @default(now())
  createdById String?

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String
  roleId String

  // v2.1 Workstream C — optional per-assignment data-scope override. Null means
  // "use the role's default scope". Honoured only when RBAC_SCOPES is enabled.
  scope DataScope?

  createdAt   DateTime @default(now())
  createdById String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

// v2.1 Workstream C — data-scope enum mirroring @techpioasset/domain DATA_SCOPES.
enum DataScope {
  ALL
  DEPARTMENT
  DIRECT_REPORTS
  OWN
}

/// Refresh-token rotation (spec section 1). One row per issued token; a reused
/// token revokes its whole family, which is how replay is detected.
model RefreshToken {
  id        String @id @default(cuid())
  userId    String
  /// SHA-256 of the token. The raw value is never stored.
  tokenHash String @unique
  familyId  String

  issuedAt      DateTime  @default(now())
  expiresAt     DateTime
  rotatedAt     DateTime?
  revokedAt     DateTime?
  revokedReason String?

  ipAddress String?
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// A registered mobile device for push delivery (spec section 16, 19).
model DeviceToken {
  id     String @id @default(cuid())
  userId String

  /// Expo push token. Unique so re-registering the same device updates rather
  /// than duplicating, which is what stops one tap sending three notifications.
  token      String  @unique
  platform   String // ios | android
  deviceName String?

  lastSeenAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("device_tokens")
}

/// Single-use tokens for email verification and password reset (spec section 1).
/// Only the SHA-256 hash is stored: a leaked table must not yield usable tokens,
/// which is the same reasoning as RefreshToken.
model VerificationToken {
  id        String              @id @default(cuid())
  userId    String
  tokenHash String              @unique
  purpose   VerificationPurpose

  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  ipAddress  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, consumedAt])
  @@index([expiresAt])
  @@map("verification_tokens")
}

// ─────────────────────────────────────────────────────────────────────────────
// Organisation and locations
// ─────────────────────────────────────────────────────────────────────────────

model Office {
  id           String  @id @default(cuid())
  companyId    String
  code         String
  name         String
  addressLine1 String?
  addressLine2 String?
  city         String?
  region       String?
  postalCode   String?
  country      String?
  timezone     String?
  isActive     Boolean @default(true)
  /// v2.28. The site a record falls back to when it names none of its own -
  /// used on handover paperwork, where a blank location reads as "we do not
  /// know where this equipment is". Set by a Super Admin, never inferred.
  /// At most one per company; enforced by a partial unique index.
  isDefault    Boolean @default(false)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  company                   Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  buildings                 Building[]
  assets                    Asset[]
  inventoryItems            InventoryItem[]
  profiles                  UserProfile[]
  requests                  AssetRequest[]
  departments               Department[]
  transfersFrom             AssetTransfer[]            @relation("TransferFromOffice")
  transfersTo               AssetTransfer[]            @relation("TransferToOffice")
  physicalInventorySessions PhysicalInventorySession[]
  aiOverrides               AIFeatureOverride[]
  stockLocations            StockLocation[]

  @@unique([companyId, code])
  @@index([deletedAt])
  @@map("offices")
}

model Building {
  id       String  @id @default(cuid())
  officeId String
  name     String
  code     String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  office Office  @relation(fields: [officeId], references: [id], onDelete: Cascade)
  floors Floor[]
  assets Asset[]

  @@unique([officeId, name])
  @@map("buildings")
}

model Floor {
  id         String @id @default(cuid())
  buildingId String
  name       String
  level      Int?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  building Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  rooms    Room[]
  assets   Asset[]

  @@unique([buildingId, name])
  @@map("floors")
}

model Room {
  id                String  @id @default(cuid())
  floorId           String
  name              String
  code              String?
  /// Rooms double as storage locations for quantity-tracked stock.
  isStorageLocation Boolean @default(false)
  capacity          Int?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  floor          Floor           @relation(fields: [floorId], references: [id], onDelete: Cascade)
  assets         Asset[]
  inventoryItems InventoryItem[]
  transfersFrom  AssetTransfer[] @relation("TransferFromRoom")
  transfersTo    AssetTransfer[] @relation("TransferToRoom")

  @@unique([floorId, name])
  @@map("rooms")
}

model Department {
  id         String  @id @default(cuid())
  companyId  String
  code       String
  name       String
  parentId   String?
  officeId   String?
  costCentre String?
  // v2.2 Workstream D — the user who heads this department, for DEPARTMENT_HEAD approvals.
  headId     String?
  isActive   Boolean @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  company  Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent   Department?  @relation("DepartmentTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Department[] @relation("DepartmentTree")
  office   Office?      @relation(fields: [officeId], references: [id], onDelete: SetNull)
  head     User?        @relation("DepartmentHead", fields: [headId], references: [id], onDelete: SetNull)

  profiles      UserProfile[]
  assets        Asset[]
  requests      AssetRequest[]
  transfersFrom AssetTransfer[] @relation("TransferFromDepartment")
  transfersTo   AssetTransfer[] @relation("TransferToDepartment")
  seatPools     SeatPool[]
  costCentres   CostCentre[]

  @@unique([companyId, code])
  @@index([parentId])
  @@map("departments")
}

// ─────────────────────────────────────────────────────────────────────────────
// Catalogue
// ─────────────────────────────────────────────────────────────────────────────

model Category {
  id                  String       @id @default(cuid())
  companyId           String
  key                 String
  name                String
  /// Lucide icon name, kept consistent with @techpioasset/ui-tokens.
  icon                String?
  sortOrder           Int          @default(0)
  isActive            Boolean      @default(true)
  /// Default tracking model for items created under this category.
  defaultTrackingType TrackingType @default(INDIVIDUAL)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subcategories  Subcategory[]
  assets         Asset[]
  inventoryItems InventoryItem[]
  requestItems   RequestItem[]
  invoiceLines   InvoiceLine[]   @relation("SuggestedCategory")
  catalogItems   CatalogItem[]
  vendorProducts VendorProduct[]
  specFields     CategorySpecField[]

  @@unique([companyId, key])
  @@index([companyId, isActive, sortOrder])
  @@map("categories")
}

/// What a category's offers are described by, and therefore what they can be
/// compared on (v2.42). Editable by an administrator: the fields worth asking a
/// laptop supplier for are not the ones worth asking a chair supplier for, and
/// nobody wants a release to add a row to a template.
model CategorySpecField {
  id         String @id @default(cuid())
  companyId  String
  categoryId String

  /// Machine key, matching the key used in VendorProduct.specs.
  key      String
  label    String
  dataType SpecFieldType @default(TEXT)
  unit     String?

  /// How a numeric requirement is read. "16 GB" means at least; "1.4 kg" means
  /// at most. Guessing from the name is how a comparison quietly inverts.
  intent NumericIntent?
  /// How far off still counts as a partial match, as a fraction. Null uses the
  /// default in @techpioasset/domain.
  tolerance Decimal? @db.Decimal(4, 3)

  /// Allowed values when dataType is ENUM.
  options String[] @default([])

  /// A vendor must fill this in before an offer can be submitted for review.
  isRequired Boolean @default(false)
  /// Offered for comparison. A field can be worth recording without being worth
  /// ranking on.
  isComparable Boolean @default(true)
  sortOrder    Int     @default(0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([companyId, categoryId, key])
  @@index([companyId, categoryId, sortOrder])
  @@index([deletedAt])
  @@map("category_spec_fields")
}

model Subcategory {
  id         String  @id @default(cuid())
  categoryId String
  key        String
  name       String
  sortOrder  Int     @default(0)
  isActive   Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  category       Category        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  assets         Asset[]
  inventoryItems InventoryItem[]
  requestItems   RequestItem[]
  vendorProducts VendorProduct[]

  @@unique([categoryId, key])
  @@map("subcategories")
}

// ─────────────────────────────────────────────────────────────────────────────
// Assets
// ─────────────────────────────────────────────────────────────────────────────

model Asset {
  id        String @id @default(cuid())
  companyId String

  assetTag      String
  name          String
  description   String?
  categoryId    String
  subcategoryId String?
  trackingType  TrackingType @default(INDIVIDUAL)

  brand                  String?
  model                  String?
  serialNumber           String?
  manufacturerPartNumber String?
  barcode                String?
  /// v2.20 identity columns. Unique per company like serialNumber, so the
  /// database refuses to register the same handset or machine twice. Postgres
  /// treats NULLs as distinct, so items without one coexist freely.
  macAddress             String?
  imei                   String?
  /// v2.20 type-specific specification (screen size, cable length, DPI...).
  /// Shape is declared per type in @techpioasset/domain asset-types.
  specs                  Json?
  /// Opaque ULID. QR codes encode this, never asset data - spec section 15
  /// forbids exposing asset information through a public QR URL.
  qrToken                String  @unique

  purchaseDate       DateTime?
  purchaseCost       Decimal?           @db.Decimal(14, 2)
  currency           String?            @db.Char(3)
  currentValue       Decimal?           @db.Decimal(14, 2)
  depreciationMethod DepreciationMethod @default(STRAIGHT_LINE)
  usefulLifeMonths   Int?
  salvageValue       Decimal?           @db.Decimal(14, 2)

  vendorId            String?
  invoiceLineId       String?
  purchaseOrderNumber String?

  warrantyStartDate       DateTime?
  warrantyEndDate         DateTime?
  expectedReplacementDate DateTime?

  officeId     String?
  buildingId   String?
  floorId      String?
  roomId       String?
  departmentId String?

  assignedUserId     String?
  assignmentDate     DateTime?
  expectedReturnDate DateTime?

  condition         AssetCondition     @default(GOOD)
  status            AssetStatus        @default(DRAFT)
  // v2.1 Workstream A — four-dimension status (nullable during expand phase).
  lifecycleState    LifecycleState?
  availabilityState AvailabilityState?
  ownershipType     OwnershipType?
  notes             String?

  /// Set only when an authorised user records a documented duplicate exception
  /// (spec section 6). Null means the uniqueness rule was satisfied normally.
  duplicateExceptionReason String?
  duplicateExceptionById   String?

  /// v2.9 C1 — set when a goods receipt created this asset. The receipt line
  /// plus the unit's position within it IS the identity: the unique index below
  /// means a replayed or retried receipt cannot create the same asset twice,
  /// so idempotency is a database guarantee rather than a code convention.
  sourceGrnLineId String?
  sourceUnitIndex Int?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?
  version     Int       @default(0)

  company       Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category      Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subcategory   Subcategory?      @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  vendor        Vendor?           @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  invoiceLine   InvoiceLine?      @relation(fields: [invoiceLineId], references: [id], onDelete: SetNull)
  sourceGrnLine GoodsReceiptLine? @relation("AssetFromReceipt", fields: [sourceGrnLineId], references: [id], onDelete: SetNull)
  office        Office?           @relation(fields: [officeId], references: [id], onDelete: SetNull)
  building      Building?         @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  floor         Floor?            @relation(fields: [floorId], references: [id], onDelete: SetNull)
  room          Room?             @relation(fields: [roomId], references: [id], onDelete: SetNull)
  department    Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  assignedUser  User?             @relation("AssetCurrentAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)

  assignments           AssetAssignment[]
  transfers             AssetTransfer[]
  conditionLogs         AssetConditionLog[]
  maintenance           MaintenanceRecord[]
  warranties            Warranty[]
  disposal              DisposalRecord?
  invoiceLinks          AssetInvoiceLink[]
  attachments           Attachment[]
  replacementFor        AssetRequest[]          @relation("RequestReplacesAsset")
  fulfilledItems        RequestItem[]           @relation("RequestItemFulfilledAsset")
  inventoryScans        PhysicalInventoryScan[]
  licenseAssignments    LicenseAssignment[]     @relation("LicenseAssignedAsset")
  hardwareProfile       HardwareProfile?
  osInfo                OperatingSystemInfo?
  installedSoftware     InstalledSoftware[]
  health                AssetHealth?
  discoveredDevices     DiscoveredDevice[]
  maintenanceSchedules  MaintenanceSchedule[]
  assessmentsSuggesting RequestAssessment[]     @relation("AssessmentSuitableAsset")

  /// Postgres treats NULLs as distinct in a unique index, so quantity-tracked
  /// rows (which carry no serial) coexist freely while real serials stay unique.
  @@unique([companyId, assetTag])
  @@unique([companyId, serialNumber])
  @@unique([companyId, macAddress])
  @@unique([companyId, imei])
  /// v2.9 C1 — the idempotency backstop. Both columns are null for every asset
  /// not born of a receipt, and Postgres treats NULLs as distinct, so those rows
  /// coexist freely while receipt-born units stay one-per-unit.
  @@unique([sourceGrnLineId, sourceUnitIndex])
  @@index([companyId, status])
  // v2.1 Workstream A — powers the flagship multi-dimension filter (AST-051).
  @@index([companyId, lifecycleState, availabilityState])
  @@index([companyId, categoryId])
  @@index([companyId, assignedUserId])
  /// v2.12 - the OWN-scope list sorts by createdAt; without the sort key in
  /// the index every page load adds an explicit sort.
  @@index([companyId, assignedUserId, createdAt])
  @@index([companyId, officeId])
  @@index([companyId, departmentId])
  @@index([companyId, warrantyEndDate])
  @@index([companyId, deletedAt])
  @@index([barcode])
  @@map("assets")
}

model InventoryItem {
  id        String @id @default(cuid())
  companyId String

  sku           String
  name          String
  description   String?
  categoryId    String
  subcategoryId String?

  /// v2.9 C4 - when true, every receipt names a lot and every issue consumes
  /// batches FIFO by expiry. Off by default: most kit has no shelf life.
  batchTracked   Boolean  @default(false)
  unit           String   @default("unit")
  quantityOnHand Decimal  @default(0) @db.Decimal(14, 3)
  quantityIssued Decimal  @default(0) @db.Decimal(14, 3)
  minStock       Decimal? @db.Decimal(14, 3)
  reorderLevel   Decimal? @db.Decimal(14, 3)

  unitCost         Decimal?  @db.Decimal(14, 2)
  averageCost      Decimal?  @db.Decimal(14, 2)
  currency         String?   @db.Char(3)
  lastPurchaseDate DateTime?

  officeId String?
  roomId   String?

  isActive Boolean @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?
  version     Int       @default(0)

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category    Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subcategory Subcategory? @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  office      Office?      @relation(fields: [officeId], references: [id], onDelete: SetNull)
  room        Room?        @relation(fields: [roomId], references: [id], onDelete: SetNull)

  transactions   InventoryTransaction[]
  invoiceLinks   AssetInvoiceLink[]
  prLines        PurchaseRequestLine[]
  grnLines       GoodsReceiptLine[]
  stockLevels    StockLevel[]
  stockMovements StockMovement[]
  stockTransfers StockTransfer[]
  stockBatches   StockBatch[]

  @@unique([companyId, sku])
  @@index([companyId, categoryId])
  @@index([companyId, deletedAt])
  @@map("inventory_items")
}

/// Append-only ledger behind `InventoryItem.quantityOnHand`. Without it a stock
/// balance is a number nobody can explain; with it every movement is attributable.
model InventoryTransaction {
  id              String @id @default(cuid())
  inventoryItemId String

  reason        InventoryTransactionReason
  /// Signed: positive receives stock, negative issues it.
  quantityDelta Decimal                    @db.Decimal(14, 3)
  balanceAfter  Decimal                    @db.Decimal(14, 3)
  unitCost      Decimal?                   @db.Decimal(14, 2)

  referenceType String?
  referenceId   String?
  note          String?

  actorId   String?
  createdAt DateTime @default(now())

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  actor         User?         @relation("InventoryActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([inventoryItemId, createdAt])
  @@map("inventory_transactions")
}

model AssetAssignment {
  id      String @id @default(cuid())
  assetId String
  userId  String

  assignedById      String?
  assignedAt        DateTime       @default(now())
  expectedReturnAt  DateTime?
  conditionOut      AssetCondition
  accessoriesIssued String?
  notes             String?

  /// Employee receipt confirmation (spec section 12: capture acknowledgment).
  acknowledgedAt        DateTime?
  acknowledgementMethod String?
  acknowledgementIp     String?

  returnedAt DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  asset       Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  user        User         @relation("AssignmentHolder", fields: [userId], references: [id], onDelete: Restrict)
  assignedBy  User?        @relation("AssignmentGrantedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  assetReturn AssetReturn?

  @@index([assetId, assignedAt])
  @@index([userId, returnedAt])
  @@map("asset_assignments")
}

model AssetReturn {
  id           String @id @default(cuid())
  assignmentId String @unique

  returnedAt         DateTime       @default(now())
  receivedById       String?
  conditionIn        AssetCondition
  missingAccessories String?
  damageNotes        String?
  resultingStatus    AssetStatus

  acknowledgedAt DateTime?
  notes          String?

  createdAt   DateTime @default(now())
  createdById String?

  assignment AssetAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  receivedBy User?           @relation("ReturnReceivedBy", fields: [receivedById], references: [id], onDelete: SetNull)

  @@map("asset_returns")
}

/// Spec section 12: "Do not overwrite history." Every transfer is a new row
/// recording both sides of the move.
model AssetTransfer {
  id      String @id @default(cuid())
  assetId String

  transferType TransferType

  fromUserId       String?
  toUserId         String?
  fromDepartmentId String?
  toDepartmentId   String?
  fromRoomId       String?
  toRoomId         String?
  fromOfficeId     String?
  toOfficeId       String?
  fromCompanyId    String?
  toCompanyId      String?

  transferredAt DateTime        @default(now())
  approvedById  String?
  reason        String?
  condition     AssetCondition?
  notes         String?

  // v2.15 - a transfer is open (the asset is IN_TRANSIT) until someone at the
  // destination confirms arrival. receivedAt IS NULL is the open marker.
  receivedAt   DateTime?
  receivedById String?

  createdAt   DateTime @default(now())
  createdById String?

  asset          Asset       @relation(fields: [assetId], references: [id], onDelete: Cascade)
  fromUser       User?       @relation("TransferFromUser", fields: [fromUserId], references: [id], onDelete: SetNull)
  toUser         User?       @relation("TransferToUser", fields: [toUserId], references: [id], onDelete: SetNull)
  approvedBy     User?       @relation("TransferApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  receivedBy     User?       @relation("TransferReceivedBy", fields: [receivedById], references: [id], onDelete: SetNull)
  fromDepartment Department? @relation("TransferFromDepartment", fields: [fromDepartmentId], references: [id], onDelete: SetNull)
  toDepartment   Department? @relation("TransferToDepartment", fields: [toDepartmentId], references: [id], onDelete: SetNull)
  fromRoom       Room?       @relation("TransferFromRoom", fields: [fromRoomId], references: [id], onDelete: SetNull)
  toRoom         Room?       @relation("TransferToRoom", fields: [toRoomId], references: [id], onDelete: SetNull)
  fromOffice     Office?     @relation("TransferFromOffice", fields: [fromOfficeId], references: [id], onDelete: SetNull)
  toOffice       Office?     @relation("TransferToOffice", fields: [toOfficeId], references: [id], onDelete: SetNull)

  @@index([assetId, transferredAt])
  @@map("asset_transfers")
}

model AssetConditionLog {
  id      String @id @default(cuid())
  assetId String

  previousCondition AssetCondition?
  newCondition      AssetCondition
  previousStatus    AssetStatus?
  newStatus         AssetStatus?
  reason            String?
  photosJson        Json?

  recordedAt  DateTime @default(now())
  createdById String?

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, recordedAt])
  @@map("asset_condition_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
// Maintenance, warranty, disposal
// ─────────────────────────────────────────────────────────────────────────────

model MaintenanceRecord {
  id      String @id @default(cuid())
  assetId String

  type   MaintenanceType
  status MaintenanceStatus @default(REQUESTED)

  title         String
  description   String?
  requestedById String?
  vendorId      String?
  isInternal    Boolean @default(false)

  scheduledFor DateTime?
  startedAt    DateTime?
  completedAt  DateTime?

  serviceCost   Decimal? @db.Decimal(14, 2)
  currency      String?  @db.Char(3)
  downtimeHours Decimal? @db.Decimal(8, 2)

  warrantyId             String?
  // v2.15 - the DAMAGE/REPAIR request this work order was raised from, so the
  // ticket and the repair reference each other instead of coexisting blindly.
  requestId              String?   @unique
  // v2.5 work-order extensions: who does the work, by when, escalated once.
  technicianId           String?
  slaDueAt               DateTime?
  escalatedAt            DateTime?
  diagnosis              String?
  replacementRecommended Boolean   @default(false)
  recommendationNote     String?
  resolutionNotes        String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  asset       Asset         @relation(fields: [assetId], references: [id], onDelete: Cascade)
  vendor      Vendor?       @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  requestedBy User?         @relation("MaintenanceRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  warranty    Warranty?     @relation(fields: [warrantyId], references: [id], onDelete: SetNull)
  request     AssetRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  attachments Attachment[]

  @@index([assetId, status])
  @@index([scheduledFor])
  @@map("maintenance_records")
}

model Warranty {
  id      String @id @default(cuid())
  assetId String

  provider      String?
  policyNumber  String?
  startDate     DateTime
  endDate       DateTime
  coverageNotes String?
  isActive      Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  asset  Asset               @relation(fields: [assetId], references: [id], onDelete: Cascade)
  claims MaintenanceRecord[]

  @@index([assetId])
  @@index([endDate])
  @@map("warranties")
}

/// Spec section 22: disposal is recorded, never a delete.
model DisposalRecord {
  id      String @id @default(cuid())
  assetId String @unique

  method         DisposalMethod
  disposedAt     DateTime
  proceeds       Decimal?       @db.Decimal(14, 2)
  currency       String?        @db.Char(3)
  recipient      String?
  reason         String
  approvedById   String?
  certificateKey String?

  createdAt   DateTime @default(now())
  createdById String?

  asset      Asset @relation(fields: [assetId], references: [id], onDelete: Restrict)
  approvedBy User? @relation("DisposalApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@map("disposal_records")
}

// ─────────────────────────────────────────────────────────────────────────────
// Procurement and invoices
// ─────────────────────────────────────────────────────────────────────────────

model Vendor {
  id        String @id @default(cuid())
  companyId String

  code         String
  name         String
  contactName  String?
  contactEmail String?
  contactPhone String?
  website      String?
  taxId        String?
  addressLine1 String?
  city         String?
  country      String?
  notes        String?
  isActive     Boolean @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  company            Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assets             Asset[]
  invoices           Invoice[]
  purchaseOrders     PurchaseOrder[]
  quotes             Quote[]
  maintenance        MaintenanceRecord[]
  softwareLicenses   SoftwareLicense[]
  requestAssessments RequestAssessment[]
  vendorProducts     VendorProduct[]
  selections         ProcurementSelection[]
  portalUsers        User[]                 @relation("VendorPortalUsers")

  @@unique([companyId, code])
  @@index([companyId, name])
  @@map("vendors")
}

model PurchaseOrder {
  id        String @id @default(cuid())
  companyId String

  poNumber String
  vendorId String
  status   PurchaseOrderStatus @default(DRAFT)

  issuedDate   DateTime?
  expectedDate DateTime?
  currency     String    @db.Char(3)
  subtotal     Decimal   @default(0) @db.Decimal(14, 2)
  tax          Decimal   @default(0) @db.Decimal(14, 2)
  shipping     Decimal   @default(0) @db.Decimal(14, 2)
  total        Decimal   @default(0) @db.Decimal(14, 2)
  notes        String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?
  version     Int       @default(0)

  company               Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vendor                Vendor               @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  lines                 PurchaseOrderLine[]
  invoices              Invoice[]
  receipts              GoodsReceipt[]
  matchResults          InvoiceMatchResult[]
  convertedFromRequests PurchaseRequest[]    @relation("RequestConvertedPo")
  /// v2.9 C3 - the winning quote this order was created from, if any.
  fromQuote             Quote[]              @relation("PoFromQuote")

  @@unique([companyId, poNumber])
  @@index([companyId, status])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id              String @id @default(cuid())
  purchaseOrderId String

  lineNumber       Int
  description      String
  quantity         Decimal @db.Decimal(14, 3)
  unitPrice        Decimal @db.Decimal(14, 2)
  lineTotal        Decimal @db.Decimal(14, 2)
  receivedQuantity Decimal @default(0) @db.Decimal(14, 3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  grnLines      GoodsReceiptLine[]

  @@unique([purchaseOrderId, lineNumber])
  @@map("purchase_order_lines")
}

model Invoice {
  id        String @id @default(cuid())
  companyId String

  invoiceNumber   String
  vendorId        String
  purchaseOrderId String?
  /// PO number as printed on the invoice, kept even before a PurchaseOrder row
  /// is matched — vendors cite it as free text and verification reconciles on it.
  poNumber        String?

  invoiceDate  DateTime
  purchaseDate DateTime?
  dueDate      DateTime?
  currency     String    @db.Char(3)

  subtotal     Decimal @default(0) @db.Decimal(14, 2)
  discount     Decimal @default(0) @db.Decimal(14, 2)
  tax          Decimal @default(0) @db.Decimal(14, 2)
  shipping     Decimal @default(0) @db.Decimal(14, 2)
  otherCharges Decimal @default(0) @db.Decimal(14, 2)
  total        Decimal @default(0) @db.Decimal(14, 2)

  paymentStatus PaymentStatus  @default(UNPAID)
  paymentMethod PaymentMethod?
  paidAt        DateTime?

  verificationStatus VerificationStatus @default(UPLOADED)
  reviewerId         String?
  reviewedAt         DateTime?
  reviewNotes        String?

  notes String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?
  version     Int       @default(0)

  company          Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vendor           Vendor                @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  purchaseOrder    PurchaseOrder?        @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  reviewer         User?                 @relation("InvoiceReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  lines            InvoiceLine[]
  documents        InvoiceDocument[]
  extractions      InvoiceExtraction[]
  verifications    InvoiceVerification[]
  softwareLicenses SoftwareLicense[]
  matchResult      InvoiceMatchResult?

  /// Deterministic duplicate-invoice-number check (spec section 9).
  @@unique([companyId, invoiceNumber])
  @@index([companyId, verificationStatus])
  @@index([companyId, vendorId])
  @@index([companyId, invoiceDate])
  @@index([companyId, paymentStatus])
  @@map("invoices")
}

model InvoiceLine {
  id        String @id @default(cuid())
  invoiceId String

  lineNumber            Int
  description           String
  /// AI-normalised description (spec section 9). The original is never overwritten.
  normalizedDescription String?
  quantity              Decimal @db.Decimal(14, 3)
  unitPrice             Decimal @db.Decimal(14, 2)
  lineTotal             Decimal @db.Decimal(14, 2)

  serialNumbers        String[]
  warrantyMonths       Int?
  suggestedCategoryId  String?
  /// 0..1 confidence for the category suggestion; null when AI is disabled.
  suggestionConfidence Decimal? @db.Decimal(4, 3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoice           Invoice            @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  suggestedCategory Category?          @relation("SuggestedCategory", fields: [suggestedCategoryId], references: [id], onDelete: SetNull)
  assets            Asset[]
  assetLinks        AssetInvoiceLink[]

  @@unique([invoiceId, lineNumber])
  @@map("invoice_lines")
}

model InvoiceDocument {
  id        String @id @default(cuid())
  invoiceId String

  /// Private object-storage key. Never a public URL (spec section 20).
  storageKey   String
  originalName String
  mimeType     String
  sizeBytes    Int
  pageCount    Int?
  /// Deterministic duplicate-file detection (spec section 9).
  sha256       String
  scanStatus   DocumentScanStatus @default(PENDING)
  scanDetail   String?

  uploadedById String?
  uploadedAt   DateTime @default(now())

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  invoice    Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  uploadedBy User?   @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([sha256])
  @@map("invoice_documents")
}

/// One row per extraction attempt. Originals are retained alongside corrections
/// so spec section 9's "save the original extraction, corrected values, decision"
/// is satisfied without mutation.
model InvoiceExtraction {
  id         String  @id @default(cuid())
  invoiceId  String
  documentId String?

  provider  String
  modelName String?
  status    VerificationStatus @default(PENDING_AI_PROCESSING)

  rawPayload        Json?
  extractedFields   Json?
  fieldConfidences  Json?
  overallConfidence Decimal? @db.Decimal(4, 3)

  startedAt   DateTime?
  completedAt DateTime?
  durationMs  Int?
  costUsd     Decimal?  @db.Decimal(10, 6)
  errorDetail String?
  /// True when produced by the mock provider (spec section 28).
  simulated   Boolean   @default(false)

  createdAt DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, createdAt])
  @@map("invoice_extractions")
}

model InvoiceVerification {
  id        String @id @default(cuid())
  invoiceId String

  /// Output of the deterministic check engine - never the AI's opinion.
  checkResults Json
  issues       Json
  outcome      VerificationStatus

  decidedById String?
  decidedAt   DateTime?
  notes       String?

  createdAt DateTime @default(now())

  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  decidedBy User?   @relation("VerificationDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([invoiceId, createdAt])
  @@map("invoice_verifications")
}

/// Join between an invoice line and what it paid for. One invoice may cover many
/// assets; one asset links to one line (spec section 8).
model AssetInvoiceLink {
  id              String  @id @default(cuid())
  invoiceLineId   String
  assetId         String?
  inventoryItemId String?

  matchConfidence Decimal? @db.Decimal(4, 3)
  /// AUTO when proposed by matching, MANUAL when a reviewer linked it.
  matchMethod     String   @default("MANUAL")
  quantityDelta   Decimal? @db.Decimal(14, 3)
  costDelta       Decimal? @db.Decimal(14, 2)

  createdAt   DateTime @default(now())
  createdById String?

  invoiceLine   InvoiceLine    @relation(fields: [invoiceLineId], references: [id], onDelete: Cascade)
  asset         Asset?         @relation(fields: [assetId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@unique([invoiceLineId, assetId])
  @@index([assetId])
  @@index([inventoryItemId])
  @@map("asset_invoice_links")
}

// ─────────────────────────────────────────────────────────────────────────────
// Requests and workflow
// ─────────────────────────────────────────────────────────────────────────────

model AssetRequest {
  id        String @id @default(cuid())
  companyId String

  requestNumber String
  type          RequestType
  status        RequestStatus   @default(DRAFT)
  priority      RequestPriority @default(NORMAL)

  requesterId   String
  beneficiaryId String?
  managerId     String?
  officeId      String?
  departmentId  String?

  /// v2.14 - which entry of the published issue catalogue the employee picked,
  /// when the request came from "Report an issue". Nullable because most
  /// requests are not fault reports, and free-form ones never were.
  issueCategory   String?
  businessReason  String
  requiredBy      DateTime?
  preferredSpec   String?
  isReplacement   Boolean   @default(false)
  replacesAssetId String?
  /// v2.17 - structured context from the dynamic request form (target asset,
  /// upgrade type, current/requested spec, replacement reason, "other" text).
  details         Json?
  estimatedCost   Decimal?  @db.Decimal(14, 2)
  currency        String?   @db.Char(3)
  notes           String?

  submittedAt DateTime?
  decidedAt   DateTime?
  completedAt DateTime?

  workflowDefinitionId String?
  currentStepOrder     Int?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?
  version     Int       @default(0)

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  requester          User                @relation("RequestRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  beneficiary        User?               @relation("RequestBeneficiary", fields: [beneficiaryId], references: [id], onDelete: SetNull)
  manager            User?               @relation("RequestManager", fields: [managerId], references: [id], onDelete: SetNull)
  office             Office?             @relation(fields: [officeId], references: [id], onDelete: SetNull)
  department         Department?         @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  replacesAsset      Asset?              @relation("RequestReplacesAsset", fields: [replacesAssetId], references: [id], onDelete: SetNull)
  workflowDefinition WorkflowDefinition? @relation(fields: [workflowDefinitionId], references: [id], onDelete: SetNull)

  items                 RequestItem[]
  approvals             RequestApproval[]
  comments              RequestComment[]
  attachments           Attachment[]
  workOrder             MaintenanceRecord?
  assessment            RequestAssessment?
  procurementSelections ProcurementSelection[]

  @@unique([companyId, requestNumber])
  @@index([companyId, status])
  @@index([companyId, requesterId])
  /// v2.12 - default list ordering.
  @@index([companyId, createdAt])
  @@index([companyId, beneficiaryId])
  @@index([companyId, managerId])
  @@map("asset_requests")
}

model RequestItem {
  id        String @id @default(cuid())
  requestId String

  categoryId       String?
  subcategoryId    String?
  description      String
  quantity         Decimal   @default(1) @db.Decimal(14, 3)
  preferredSpec    String?
  estimatedCost    Decimal?  @db.Decimal(14, 2)
  /// v2.17 - the item is NOT in the catalog: requested as a one-off, reviewed
  /// by admins who may promote it to a CatalogItem. Never auto-created as an
  /// asset - only procurement turns it into tracked inventory.
  isUncatalogued   Boolean   @default(false)
  manufacturer     String?
  model            String?
  referenceUrl     String?
  fulfilledAssetId String?
  fulfilledAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  request        AssetRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  category       Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subcategory    Subcategory? @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  fulfilledAsset Asset?       @relation("RequestItemFulfilledAsset", fields: [fulfilledAssetId], references: [id], onDelete: SetNull)

  @@index([requestId])
  @@map("request_items")
}

/// v2.17 - an admin-curated equipment name for the request form's picker.
/// A catalog item is a TYPE ("HDMI Cable"), not a tracked asset; the picker
/// merges these with the baseline and the company's real asset names.
model CatalogItem {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  categoryId  String?
  createdById String?
  createdAt   DateTime @default(now())

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@unique([companyId, name])
  @@map("catalog_items")
}

model RequestApproval {
  id        String @id @default(cuid())
  requestId String

  stepOrder      Int
  stepName       String
  approverType   ApproverType
  approverRoleId String?
  approverId     String?

  decision          ApprovalDecision @default(WAITING)
  decidedAt         DateTime?
  comment           String?
  slaDueAt          DateTime?
  /// v2.24 - the approver has opened the step without deciding yet. Purely
  /// informational: it changes what the chain says ("Under review by X"
  /// instead of "Awaiting decision"), never what anyone may do.
  reviewStartedAt   DateTime?
  reviewStartedById String?
  /// v2.25 - the threshold this step was configured with when the chain was
  /// built. Snapshotted rather than looked up so changing a workflow later
  /// cannot silently re-decide a request already in flight.
  costThreshold     Decimal?         @db.Decimal(14, 2)
  /// Snapshotted like the threshold: what this step asks of its holder.
  kind              WorkflowStepKind @default(APPROVAL)
  // v2.2 Workstream D — set when the SLA-escalation sweep has escalated this
  // overdue step, so it is escalated (and notified) exactly once.
  escalatedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  request         AssetRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  approver        User?        @relation("ApprovalApprover", fields: [approverId], references: [id], onDelete: SetNull)
  /// Needed so an "awaiting my decision" query can traverse from the step to the
  /// role's current holders rather than resolving them in application code.
  approverRole    Role?        @relation("ApprovalApproverRole", fields: [approverRoleId], references: [id], onDelete: SetNull)
  reviewStartedBy User?        @relation("ApprovalReviewer", fields: [reviewStartedById], references: [id], onDelete: SetNull)

  @@unique([requestId, stepOrder])
  @@index([approverId, decision])
  @@index([approverRoleId, decision])
  @@map("request_approvals")
}

/// v2.25 - what a request actually costs, decided internally.
///
/// The employee states a requirement; they never state a price. Everything
/// commercial lives here and is writable only by roles holding
/// requests:assess (Office Admin, Finance, Super Admin), which is what stops a
/// requester choosing the number that decides whether Finance reviews their
/// own request.
model RequestAssessment {
  id        String @id @default(cuid())
  companyId String
  requestId String @unique

  /// Is there already something suitable on the shelf?
  inventoryAvailable Boolean?
  /// The specific asset found, when one was.
  suitableAssetId    String?
  /// False means no new expenditure, and Finance is skipped for that reason.
  purchaseRequired   Boolean?

  suggestedProduct String?
  vendorId         String?

  unitPrice Decimal? @db.Decimal(14, 2)
  quantity  Int?
  taxAmount Decimal? @db.Decimal(14, 2)
  shipping  Decimal? @db.Decimal(14, 2)
  discount  Decimal? @db.Decimal(14, 2)
  /// Computed from the parts above on every write, never accepted from a
  /// client: the figure that routes the request must not be assertable.
  totalCost Decimal? @db.Decimal(14, 2)
  currency  String?  @db.Char(3)

  notes String?

  assessedById String?
  assessedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company       Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  request       AssetRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  suitableAsset Asset?       @relation("AssessmentSuitableAsset", fields: [suitableAssetId], references: [id], onDelete: SetNull)
  vendor        Vendor?      @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  assessedBy    User?        @relation("AssessmentAssessor", fields: [assessedById], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@map("request_assessments")
}

model RequestComment {
  id        String  @id @default(cuid())
  requestId String
  authorId  String?

  body       String
  /// Internal notes stay hidden from the requesting employee.
  isInternal Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  request AssetRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author  User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([requestId, createdAt])
  @@map("request_comments")
}

/// Spec section 11: "Allow Super Admins to configure workflow steps, approvers,
/// thresholds, and bypass rules." That makes the chain data, not code.
model WorkflowDefinition {
  id        String @id @default(cuid())
  companyId String

  key         String
  name        String
  description String?
  /// Null applies the definition to every request type not otherwise matched.
  requestType RequestType?
  isActive    Boolean      @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  company  Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  steps    WorkflowStep[]
  requests AssetRequest[]

  @@unique([companyId, key])
  @@index([companyId, requestType, isActive])
  @@map("workflow_definitions")
}

model WorkflowStep {
  id                   String @id @default(cuid())
  workflowDefinitionId String

  stepOrder      Int
  name           String
  kind           WorkflowStepKind @default(APPROVAL)
  approverType   ApproverType
  approverRoleId String?
  approverUserId String?

  /// Step is skipped when the request total is at or below this figure
  /// (spec section 11: kitchen requests need finance approval only above a threshold).
  costThreshold Decimal? @db.Decimal(14, 2)
  isSkippable   Boolean  @default(false)
  slaHours      Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workflowDefinition WorkflowDefinition @relation(fields: [workflowDefinitionId], references: [id], onDelete: Cascade)
  approverRole       Role?              @relation("StepApproverRole", fields: [approverRoleId], references: [id], onDelete: SetNull)

  @@unique([workflowDefinitionId, stepOrder])
  @@map("workflow_steps")
}

// ─────────────────────────────────────────────────────────────────────────────
// Onboarding and offboarding
// ─────────────────────────────────────────────────────────────────────────────

model OnboardingTemplate {
  id        String @id @default(cuid())
  companyId String

  key          String
  name         String
  departmentId String?
  jobTitle     String?
  isActive     Boolean @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?

  company Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items   OnboardingTemplateItem[]
  tasks   OnboardingTask[]

  @@unique([companyId, key])
  @@map("onboarding_templates")
}

model OnboardingTemplateItem {
  id         String @id @default(cuid())
  templateId String

  categoryId    String?
  subcategoryId String?
  description   String
  quantity      Decimal @default(1) @db.Decimal(14, 3)
  isRequired    Boolean @default(true)
  sortOrder     Int     @default(0)

  createdAt DateTime @default(now())

  template OnboardingTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@map("onboarding_template_items")
}

/// Drives both onboarding and offboarding checklists. Spec section 13: offboarding
/// cannot complete until every required asset has an outcome or approved exception.
model OnboardingTask {
  id            String  @id @default(cuid())
  companyId     String
  templateId    String?
  subjectUserId String

  /// ONBOARDING or OFFBOARDING.
  direction String
  status    String @default("OPEN")

  startedAt   DateTime  @default(now())
  dueAt       DateTime?
  completedAt DateTime?

  /// Set when an unresolved asset is signed off deliberately rather than returned.
  exceptionReason       String?
  exceptionApprovedById String?

  checklistJson Json?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  template    OnboardingTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  subjectUser User                @relation("OnboardingSubject", fields: [subjectUserId], references: [id], onDelete: Cascade)

  @@index([companyId, direction, status])
  @@index([subjectUserId])
  @@map("onboarding_tasks")
}

// ─────────────────────────────────────────────────────────────────────────────
// Notifications, attachments, AI, audit
// ─────────────────────────────────────────────────────────────────────────────

model Notification {
  id        String @id @default(cuid())
  companyId String
  userId    String

  type       NotificationType
  channel    NotificationChannel @default(IN_APP)
  title      String
  body       String
  /// Deep link into web or mobile.
  linkPath   String?
  entityType String?
  entityId   String?

  readAt        DateTime?
  deliveredAt   DateTime?
  failedAt      DateTime?
  failureDetail String?
  /// True when delivered by a mock provider (spec section 28).
  simulated     Boolean   @default(false)

  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  /// v2.12 - the default (not unread-only) list filters on userId and sorts by
  /// createdAt; readAt sitting between them stops the wider index serving it.
  @@index([userId, createdAt])
  @@index([companyId, type])
  @@map("notifications")
}

model NotificationPreference {
  id     String @id @default(cuid())
  userId String

  type    NotificationType
  channel NotificationChannel
  enabled Boolean             @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, channel])
  @@map("notification_preferences")
}

/// Polymorphic file attachment. Storage keys are private; access always goes
/// through a signed, permission-checked URL.
/// v2.18 - per-company overrides for notification emails. Absent row = the
/// code default; subject/body accept {{variable}} placeholders.
model EmailTemplate {
  id          String           @id @default(cuid())
  companyId   String
  type        NotificationType
  subject     String
  heading     String?
  body        String
  ctaLabel    String?
  enabled     Boolean          @default(true)
  updatedById String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, type])
  @@map("email_templates")
}

/// v2.18 - who an event reaches beyond its natural recipient: role-based
/// To/CC, escalation roles, warranty thresholds, and the off switch.
model NotificationRule {
  id                 String           @id @default(cuid())
  companyId          String
  type               NotificationType
  enabled            Boolean          @default(true)
  /// Keep notifying the event's natural recipient (holder, employee, requester).
  notifyPrimary      Boolean          @default(true)
  recipientRoleKeys  String[]
  ccRoleKeys         String[]
  escalationRoleKeys String[]
  /// Day marks for threshold events (warranty): e.g. [90,60,30,15,7,1,0].
  thresholds         Int[]
  updatedById        String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, type])
  @@map("notification_rules")
}

/// v2.18 - one row per outgoing notification email: who, what, and whether it
/// left the building. SENT / SIMULATED / FAILED with the provider error kept.
model EmailLog {
  id         String           @id @default(cuid())
  companyId  String
  type       NotificationType
  toEmail    String
  toUserId   String?
  subject    String
  status     String
  error      String?
  entityType String?
  entityId   String?
  createdAt  DateTime         @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@index([companyId, status])
  @@map("email_logs")
}

model Attachment {
  id        String @id @default(cuid())
  companyId String

  entityType String
  entityId   String

  storageKey   String
  originalName String
  mimeType     String
  sizeBytes    Int
  sha256       String
  scanStatus   DocumentScanStatus @default(PENDING)
  caption      String?

  uploadedById String?
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  company             Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  asset               Asset?             @relation(fields: [assetId], references: [id], onDelete: Cascade)
  assetId             String?
  assetRequest        AssetRequest?      @relation(fields: [assetRequestId], references: [id], onDelete: Cascade)
  assetRequestId      String?
  maintenanceRecord   MaintenanceRecord? @relation(fields: [maintenanceRecordId], references: [id], onDelete: Cascade)
  maintenanceRecordId String?

  @@index([companyId, entityType, entityId])
  @@index([sha256])
  /// v2.12 - request detail loads attachments through this FK on every open,
  /// and Postgres does not index foreign keys for you.
  @@index([assetRequestId, deletedAt])
  @@map("attachments")
}

/// Spec section 10. One row per company; feature switches live in `featureModes`,
/// with per-office and per-role narrowing in AIFeatureOverride.
model AIConfiguration {
  id        String @id @default(cuid())
  companyId String @unique

  globallyEnabled Boolean   @default(false)
  pausedAt        DateTime?

  /// Map of AiFeature -> AiFeatureMode.
  featureModes Json

  confidenceThreshold Decimal  @default(0.85) @db.Decimal(4, 3)
  monthlyBudgetUsd    Decimal? @db.Decimal(12, 2)
  monthlyRequestLimit Int?
  alertThresholdPct   Int      @default(80)
  retentionDays       Int      @default(365)

  /// Spec section 10 default: never true without an explicit, audited change.
  automaticFinancialApproval Boolean @default(false)
  humanReviewRequired        Boolean @default(true)

  providerName String @default("mock")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedById String?
  version     Int      @default(0)

  company   Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  overrides AIFeatureOverride[]

  @@map("ai_configurations")
}

model AIFeatureOverride {
  id                String @id @default(cuid())
  aiConfigurationId String

  feature  AiFeature
  mode     AiFeatureMode
  officeId String?
  roleKey  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  configuration AIConfiguration @relation(fields: [aiConfigurationId], references: [id], onDelete: Cascade)
  office        Office?         @relation(fields: [officeId], references: [id], onDelete: Cascade)

  @@unique([aiConfigurationId, feature, officeId, roleKey])
  @@map("ai_feature_overrides")
}

model AIUsageRecord {
  id        String  @id @default(cuid())
  companyId String
  userId    String?

  feature   AiFeature
  provider  String
  modelName String?

  entityType String?
  entityId   String?

  inputSummary     Json?
  extractedValues  Json?
  confidence       Decimal? @db.Decimal(4, 3)
  suggestedResult  Json?
  userCorrections  Json?
  reviewerDecision String?

  durationMs    Int?
  costUsd       Decimal? @db.Decimal(10, 6)
  succeeded     Boolean  @default(true)
  failureDetail String?
  simulated     Boolean  @default(false)

  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, feature, createdAt])
  @@index([companyId, createdAt])
  @@map("ai_usage_records")
}

/// Append-only. Spec section 21: audit records must not be editable through the
/// normal application interface - there is no update or delete route for this model.
model AuditLog {
  id        String @id @default(cuid())
  companyId String

  actorId    String?
  action     AuditAction
  entityType String
  entityId   String

  previousValues Json?
  newValues      Json?
  reason         String?

  ipAddress     String?
  userAgent     String?
  clientType    String?
  correlationId String?

  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actor   User?   @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([companyId, entityType, entityId, createdAt])
  @@index([companyId, actorId, createdAt])
  @@index([companyId, action, createdAt])
  @@index([correlationId])
  /// v2.10 S4 — the default view is "this tenant, newest first", with no
  /// other filter. Every other index here leads with companyId and then a
  /// SECOND equality column, so none of them can serve that sort: EXPLAIN
  /// showed a parallel sequential scan of 2M rows feeding a top-N heapsort.
  @@index([companyId, createdAt])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
// Physical inventory and reporting
// ─────────────────────────────────────────────────────────────────────────────

model PhysicalInventorySession {
  id        String @id @default(cuid())
  companyId String

  name     String
  officeId String?
  ownerId  String?
  status   PhysicalInventoryStatus @default(OPEN)

  startedAt     DateTime  @default(now())
  closedAt      DateTime?
  expectedCount Int?
  scannedCount  Int       @default(0)
  notes         String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  company Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  office  Office?                 @relation(fields: [officeId], references: [id], onDelete: SetNull)
  owner   User?                   @relation("SessionOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  scans   PhysicalInventoryScan[]

  @@index([companyId, status])
  @@map("physical_inventory_sessions")
}

model PhysicalInventoryScan {
  id        String @id @default(cuid())
  sessionId String

  assetId     String?
  scannedCode String
  result      PhysicalInventoryScanResult

  foundRoomId String?
  condition   AssetCondition?
  note        String?
  photoKey    String?

  /// Client-generated so an offline queue can replay without creating duplicates
  /// (spec section 16: queue offline changes, prevent conflicting updates).
  clientGeneratedId String   @unique
  scannedAt         DateTime
  syncedAt          DateTime @default(now())
  scannedById       String?

  session   PhysicalInventorySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  asset     Asset?                   @relation(fields: [assetId], references: [id], onDelete: SetNull)
  scannedBy User?                    @relation("ScanBy", fields: [scannedById], references: [id], onDelete: SetNull)

  @@index([sessionId, result])
  @@map("physical_inventory_scans")
}

model SavedFilter {
  id        String @id @default(cuid())
  companyId String
  userId    String

  name       String
  resource   String
  filterJson Json
  isShared   Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, resource, name])
  @@map("saved_filters")
}

model ScheduledReport {
  id        String @id @default(cuid())
  companyId String
  ownerId   String

  name       String
  resource   String
  filterJson Json?
  format     String   @default("CSV")
  /// Standard 5-field cron expression, evaluated in the company timezone.
  cron       String
  recipients String[]
  isActive   Boolean  @default(true)

  lastRunAt     DateTime?
  lastRunStatus String?
  nextRunAt     DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  owner   User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([companyId, isActive, nextRunAt])
  @@map("scheduled_reports")
}

// v2.2 Workstream D — an approval delegation: `delegator` lets `delegate` act on
// their approval steps within an optional window. SoD is preserved by the decide
// path (a delegate can never approve the delegator's — or their own — request).
model ApprovalDelegation {
  id          String    @id @default(cuid())
  companyId   String
  delegatorId String
  delegateId  String
  startsAt    DateTime?
  endsAt      DateTime?
  reason      String?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  delegator User    @relation("DelegationDelegator", fields: [delegatorId], references: [id], onDelete: Cascade)
  delegate  User    @relation("DelegationDelegate", fields: [delegateId], references: [id], onDelete: Cascade)

  @@index([companyId, delegateId])
  @@index([companyId, delegatorId])
  @@map("approval_delegations")
}

// ─────────────────────────────────────────────────────────────────────────────
// v2.3 License Management (blueprint Part A). Seat scarcity is enforced on
// SeatPool.seatsReserved via an atomic conditional increment; the DB CHECK
// (migration SQL) is the last line of defence. seats used/available are always
// DERIVED — never stored authoritatively on the license row.
// ─────────────────────────────────────────────────────────────────────────────

enum LicenseFamily {
  PRODUCTIVITY_SUITE
  OPERATING_SYSTEM
  SECURITY
  DEVELOPER_TOOLS
  DESIGN_CREATIVE
  SAAS
  DATABASE_SERVER
  OTHER
}

enum LicenseSubscriptionType {
  PERPETUAL
  SUBSCRIPTION
  OEM
  VOLUME
  OPEN
}

enum LicenseUnit {
  USER
  DEVICE
}

enum LicenseCostModel {
  PER_SEAT
  FLAT
  PER_CPU
  PER_CORE
}

enum LicenseStatus {
  ACTIVE
  EXPIRING
  EXPIRED
  RETIRED
}

enum LicenseAssignmentStatus {
  ACTIVE
  REVOKED
}

model SoftwareLicense {
  id        String @id @default(cuid())
  companyId String

  name             String
  family           LicenseFamily
  vendorId         String?
  subscriptionType LicenseSubscriptionType
  edition          String?
  purchaseDate     DateTime
  /// Null for perpetual licenses.
  expiryDate       DateTime?
  renewalDate      DateTime?
  autoRenewal      Boolean                 @default(false)
  /// Changes only via LicenseRenewal (seatsDelta) — append-only history.
  seatsPurchased   Int
  unitOfAssignment LicenseUnit

  costAmount          Decimal?         @db.Decimal(14, 2)
  costCurrency        String?          @db.Char(3)
  costModel           LicenseCostModel @default(PER_SEAT)
  invoiceId           String?
  purchaseOrderNumber String?

  /// RETIRED is set explicitly; ACTIVE/EXPIRING/EXPIRED derive from expiryDate
  /// (packages/domain/license.ts) and are cached here by the sweep.
  status LicenseStatus @default(ACTIVE)
  notes  String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  company     Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vendor      Vendor?             @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  invoice     Invoice?            @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  pools       SeatPool[]
  assignments LicenseAssignment[]
  keys        LicenseKey[]
  renewals    LicenseRenewal[]

  @@index([companyId, status])
  @@index([companyId, expiryDate])
  @@index([deletedAt])
  @@map("software_licenses")
}

model SeatPool {
  id        String @id @default(cuid())
  companyId String
  licenseId String

  name           String
  /// Σ allocations across a license's pools ≤ seatsPurchased (service-enforced).
  seatsAllocated Int
  /// The scarce counter. 0 ≤ seatsReserved ≤ seatsAllocated (DB CHECK).
  seatsReserved  Int     @default(0)
  departmentId   String?
  costCenter     String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  license     SoftwareLicense     @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  department  Department?         @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  assignments LicenseAssignment[]

  @@unique([licenseId, name])
  @@index([companyId])
  @@map("seat_pools")
}

model LicenseAssignment {
  id         String @id @default(cuid())
  companyId  String
  licenseId  String
  seatPoolId String

  /// Exactly one of userId/assetId is set, matching the license's unit
  /// (DB CHECK + partial unique indexes in the migration SQL).
  userId  String?
  assetId String?

  status       LicenseAssignmentStatus @default(ACTIVE)
  assignedAt   DateTime                @default(now())
  assignedById String?
  revokedAt    DateTime?
  revokedById  String?
  reason       String?

  license  SoftwareLicense @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  seatPool SeatPool        @relation(fields: [seatPoolId], references: [id], onDelete: Cascade)
  user     User?           @relation("LicenseAssignee", fields: [userId], references: [id], onDelete: Cascade)
  asset    Asset?          @relation("LicenseAssignedAsset", fields: [assetId], references: [id], onDelete: Cascade)

  @@index([licenseId, status])
  @@index([companyId, userId])
  @@index([companyId, assetId])
  @@map("license_assignments")
}

model LicenseKey {
  id        String @id @default(cuid())
  companyId String
  licenseId String

  /// AES-256-GCM ciphertext (LICENSE_KEY_SECRET). The API only ever returns the
  /// masked form; reveals need licenses:keys:reveal and write an audit row.
  keyCiphertext String
  keyLast4      String
  note          String?

  createdAt   DateTime @default(now())
  createdById String?

  license SoftwareLicense @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@index([licenseId])
  @@map("license_keys")
}

model LicenseRenewal {
  id        String @id @default(cuid())
  companyId String
  licenseId String

  renewedAt      DateTime  @default(now())
  previousExpiry DateTime?
  newExpiry      DateTime?
  /// Seats added (or removed, negative) by this renewal.
  seatsDelta     Int       @default(0)
  costAmount     Decimal?  @db.Decimal(14, 2)
  costCurrency   String?   @db.Char(3)
  notes          String?

  createdById String?

  license SoftwareLicense @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@index([licenseId, renewedAt])
  @@map("license_renewals")
}

// -----------------------------------------------------------------------------
// v2.4 Procurement & Warehouse Inventory (blueprint Volume III). The stock
// ledger (stock_movements) is append-only and is the truth; StockLevel is a
// cached rollup guarded by CHECKs and reconciled by the nightly sweep. Receipts
// are append-only; over-receipt is refused by a conditional update against
// PurchaseOrderLine.receivedQuantity (CHECK-backed, like seat pools).
// -----------------------------------------------------------------------------

/// v2.9 C2 — who the money belongs to. A cost centre is the unit a budget is
/// set for and a purchase request is charged to; departments are an org chart,
/// which is a different question and often a different shape.
model CostCentre {
  id        String @id @default(cuid())
  companyId String

  code         String
  name         String
  departmentId String?
  /// Accountable for the spend; notified when their budget runs low.
  ownerId      String?
  isActive     Boolean @default(true)
  notes        String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department       Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  owner            User?             @relation("CostCentreOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  budgets          Budget[]
  purchaseRequests PurchaseRequest[]

  @@unique([companyId, code])
  @@index([companyId, isActive])
  @@map("cost_centres")
}

/// v2.9 C2 — a hard limit, not a warning.
///
/// `committed` is money promised but not yet invoiced: an approved purchase
/// request holds its estimate here until it is cancelled. Every write to it is
/// an atomic conditional UPDATE whose WHERE clause is the limit, with the CHECK
/// constraint in the migration as the backstop - the same shape that guards
/// licence seats and purchase-order receipts.
model Budget {
  id        String @id @default(cuid())
  companyId String

  costCentreId String
  /// What a human calls it: "FY26 Q1 - IT".
  name         String
  periodStart  DateTime @db.Date
  periodEnd    DateTime @db.Date
  currency     String   @db.Char(3)
  amount       Decimal  @db.Decimal(14, 2)
  committed    Decimal  @default(0) @db.Decimal(14, 2)
  notes        String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?
  version     Int       @default(0)

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  costCentre       CostCentre        @relation(fields: [costCentreId], references: [id], onDelete: Restrict)
  purchaseRequests PurchaseRequest[]

  /// One budget per cost centre per period; overlapping periods are refused in
  /// the service, because "which budget does this charge?" must have one answer.
  @@unique([costCentreId, periodStart, periodEnd])
  @@index([companyId, costCentreId])
  @@map("budgets")
}

/// v2.9 C3 - the competitive-quoting record.
///
/// Before this, "why this vendor at this price?" was answered in somebody's
/// email. An RFQ puts the question and its answer next to the purchase they
/// justify, and the award is the ONLY route from a quote to an order.
model QuoteRequest {
  id        String @id @default(cuid())
  companyId String

  rfqNumber         String
  purchaseRequestId String
  status            QuoteRequestStatus @default(SENT)
  dueDate           DateTime?
  notes             String?

  /// Set once, by the award, and never moved. The conditional UPDATE that sets
  /// it is what makes a second award impossible rather than merely unlikely.
  awardedQuoteId String?   @unique
  awardReason    String?
  awardedById    String?
  awardedAt      DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchaseRequest PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  awardedQuote    Quote?          @relation("AwardedQuote", fields: [awardedQuoteId], references: [id], onDelete: SetNull)
  quotes          Quote[]         @relation("QuotesForRequest")

  @@unique([companyId, rfqNumber])
  @@index([companyId, status])
  @@map("quote_requests")
}

/// One vendor's answer. Created as INVITED when the RFQ goes out; a response
/// fills in the numbers; exactly one becomes AWARDED and the rest LOST.
model Quote {
  id        String @id @default(cuid())
  companyId String

  quoteRequestId String
  vendorId       String
  status         QuoteStatus @default(INVITED)

  /// The vendor's own reference, so a paper quote can be matched to this row.
  reference    String?
  currency     String?   @db.Char(3)
  subtotal     Decimal?  @db.Decimal(14, 2)
  total        Decimal?  @db.Decimal(14, 2)
  leadTimeDays Int?
  validUntil   DateTime?
  notes        String?
  receivedAt   DateTime?

  /// Set when the awarded quote becomes an order. Losing quotes never carry it.
  convertedPoId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company      Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  quoteRequest QuoteRequest   @relation("QuotesForRequest", fields: [quoteRequestId], references: [id], onDelete: Cascade)
  vendor       Vendor         @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  convertedPo  PurchaseOrder? @relation("PoFromQuote", fields: [convertedPoId], references: [id], onDelete: SetNull)
  awardedFor   QuoteRequest?  @relation("AwardedQuote")
  lines        QuoteLine[]

  @@unique([quoteRequestId, vendorId])
  @@index([companyId, status])
  @@map("quotes")
}

model QuoteLine {
  id      String @id @default(cuid())
  quoteId String

  lineNumber            Int
  purchaseRequestLineId String?
  description           String
  quantity              Decimal @db.Decimal(14, 3)
  unitPrice             Decimal @db.Decimal(14, 2)
  lineTotal             Decimal @db.Decimal(14, 2)

  quote               Quote                @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  purchaseRequestLine PurchaseRequestLine? @relation(fields: [purchaseRequestLineId], references: [id], onDelete: SetNull)

  @@unique([quoteId, lineNumber])
  @@map("quote_lines")
}

enum QuoteRequestStatus {
  SENT
  AWARDED
  CANCELLED
}

enum QuoteStatus {
  INVITED
  RECEIVED
  DECLINED
  AWARDED
  LOST
}

enum PurchaseRequestStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CONVERTED
  CANCELLED
}

enum GrnLineIntake {
  STOCK
  ASSET
}

enum StockMovementType {
  RECEIPT
  ISSUE
  /// v2.21 - a consumable handed back by the person who was issued it.
  RETURN
  ADJUST_UP
  ADJUST_DOWN
  TRANSFER_IN
  TRANSFER_OUT
  COUNT_CORRECTION
  CONVERT_TO_ASSET
}

enum InvoiceMatchOutcome {
  MATCHED
  QTY_MISMATCH
  PRICE_MISMATCH
  NO_RECEIPT
  NO_PO
}

model PurchaseRequest {
  id        String @id @default(cuid())
  companyId String

  prNumber       String
  status         PurchaseRequestStatus @default(DRAFT)
  requesterId    String
  neededBy       DateTime?
  /// Why the purchase is needed - approvers read this first.
  justification  String
  estimatedTotal Decimal?              @db.Decimal(14, 2)
  currency       String?               @db.Char(3)

  submittedAt    DateTime?
  approvedById   String?
  approvedAt     DateTime?
  rejectedReason String?
  /// Set when converted; the PO carries the lines from there on.
  convertedPoId  String?

  /// v2.9 C2 — what this spend is charged to, and what it is holding.
  /// `committedAmount` is non-null only while the commitment is live; releasing
  /// clears it in the same guarded step that gives the money back, so a double
  /// release is impossible rather than merely unlikely.
  costCentreId    String?
  budgetId        String?
  committedAmount Decimal?  @db.Decimal(14, 2)
  committedAt     DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  company               Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  requester             User                   @relation("PurchaseRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  convertedPo           PurchaseOrder?         @relation("RequestConvertedPo", fields: [convertedPoId], references: [id], onDelete: SetNull)
  costCentre            CostCentre?            @relation(fields: [costCentreId], references: [id], onDelete: Restrict)
  quoteRequests         QuoteRequest[]
  budget                Budget?                @relation(fields: [budgetId], references: [id], onDelete: Restrict)
  lines                 PurchaseRequestLine[]
  procurementSelections ProcurementSelection[]

  @@unique([companyId, prNumber])
  @@index([companyId, status])
  @@index([deletedAt])
  @@map("purchase_requests")
}

model PurchaseRequestLine {
  id                String @id @default(cuid())
  purchaseRequestId String

  lineNumber         Int
  description        String
  quantity           Decimal  @db.Decimal(14, 3)
  estimatedUnitPrice Decimal? @db.Decimal(14, 2)
  /// Optional link when the line replenishes tracked stock.
  inventoryItemId    String?

  purchaseRequest PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItem?  @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  quoteLines      QuoteLine[]

  @@unique([purchaseRequestId, lineNumber])
  @@map("purchase_request_lines")
}

/// Append-only: a receipt is a fact about the loading dock, never edited.
model GoodsReceipt {
  id        String @id @default(cuid())
  companyId String

  grnNumber       String
  purchaseOrderId String
  receivedById    String?
  receivedAt      DateTime @default(now())
  notes           String?

  createdAt DateTime @default(now())

  company       Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  lines         GoodsReceiptLine[]

  @@unique([companyId, grnNumber])
  @@index([purchaseOrderId])
  @@map("goods_receipts")
}

/// Whether what arrived is fit to use (v2.42).
///
/// Receiving says a box turned up; this says the contents pass. It is also what
/// lets a received asset become available - until now nothing did that
/// automatically, so assets sat in RECEIVED until somebody edited them by hand.
///
/// One per receipt line: a line is inspected once, and a second opinion is a
/// deliberate act rather than an accident of double submission.
model QualityCheck {
  id        String @id @default(cuid())
  companyId String

  goodsReceiptLineId String

  outcome QualityOutcome
  /// Always equals the quantity on the receipt line; held so the arithmetic
  /// that was checked stays visible even if the line is later corrected.
  quantityInspected Decimal @db.Decimal(14, 3)
  quantityAccepted  Decimal @db.Decimal(14, 3)
  quantityRejected  Decimal @db.Decimal(14, 3)

  /// Required whenever anything was rejected: a rejection nobody explained is
  /// one the vendor cannot be held to.
  rejectionReason String?
  disposition     RejectDisposition?
  notes           String?

  inspectedById String?
  inspectedAt   DateTime @default(now())
  createdAt     DateTime @default(now())

  company          Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  goodsReceiptLine GoodsReceiptLine @relation(fields: [goodsReceiptLineId], references: [id], onDelete: Cascade)
  inspectedBy      User?            @relation("QualityInspector", fields: [inspectedById], references: [id], onDelete: SetNull)

  @@unique([goodsReceiptLineId])
  @@index([companyId, outcome])
  @@map("quality_checks")
}

model GoodsReceiptLine {
  id             String @id @default(cuid())
  goodsReceiptId String

  purchaseOrderLineId String
  /// Always positive (CHECK); over-receipt is refused at the PO line.
  quantity            Decimal       @db.Decimal(14, 3)
  intake              GrnLineIntake
  /// STOCK intake posts here; ASSET intake creates a draft asset instead.
  stockLocationId     String?
  inventoryItemId     String?
  note                String?

  goodsReceipt      GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderLine PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Cascade)
  stockLocation     StockLocation?    @relation(fields: [stockLocationId], references: [id], onDelete: SetNull)
  inventoryItem     InventoryItem?    @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  /// v2.9 C1 — the assets this line brought into existence.
  assets            Asset[]           @relation("AssetFromReceipt")
  qualityCheck      QualityCheck?

  @@index([purchaseOrderLineId])
  @@map("goods_receipt_lines")
}

/// One current match verdict per invoice; re-running the match replaces it.
model InvoiceMatchResult {
  id        String @id @default(cuid())
  companyId String

  invoiceId       String              @unique
  purchaseOrderId String?
  outcome         InvoiceMatchOutcome
  /// Honest numbers behind the verdict: per-line qty/price deltas, totals.
  details         Json
  overriddenById  String?
  overriddenAt    DateTime?
  overrideReason  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoice       Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)

  @@index([companyId, outcome])
  @@map("invoice_match_results")
}

model StockLocation {
  id        String @id @default(cuid())
  companyId String

  code     String
  name     String
  officeId String?
  isActive Boolean @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  company  Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  office   Office?            @relation(fields: [officeId], references: [id], onDelete: SetNull)
  levels   StockLevel[]
  grnLines GoodsReceiptLine[]
  batches  StockBatch[]

  @@unique([companyId, code])
  @@index([deletedAt])
  @@map("stock_locations")
}

/// Cached rollup of the ledger for one (item, location). CHECK-guarded; the
/// sweep reconciles cache == sum(ledger) and WARNs on drift.
model StockLevel {
  id        String @id @default(cuid())
  companyId String

  inventoryItemId String
  stockLocationId String
  quantity        Decimal @default(0) @db.Decimal(14, 3)
  reserved        Decimal @default(0) @db.Decimal(14, 3)

  updatedAt DateTime @updatedAt

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  stockLocation StockLocation @relation(fields: [stockLocationId], references: [id], onDelete: Cascade)

  @@unique([inventoryItemId, stockLocationId])
  @@index([companyId])
  @@map("stock_levels")
}

/// The append-only truth. quantity is always positive; the type carries the sign.
/// v2.9 C4 - a lot of one item at one location.
///
/// `quantity` is a guarded cache in exactly the way stock_levels is: every
/// change is an atomic conditional UPDATE, with a CHECK constraint stopping it
/// going negative, and the movement ledger remains the truth it summarises.
model StockBatch {
  id        String @id @default(cuid())
  companyId String

  inventoryItemId String
  stockLocationId String
  /// The vendor's lot code, or whatever the receiving clerk wrote on the box.
  batchNumber     String
  expiryDate      DateTime? @db.Date
  quantity        Decimal   @default(0) @db.Decimal(14, 3)
  receivedAt      DateTime  @default(now())
  /// Which receipt line brought it in, when it came through procurement.
  sourceGrnLineId String?
  notes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company       Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem   @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  stockLocation StockLocation   @relation(fields: [stockLocationId], references: [id], onDelete: Cascade)
  movements     StockMovement[]

  @@unique([inventoryItemId, stockLocationId, batchNumber])
  @@index([companyId, expiryDate])
  @@map("stock_batches")
}

model StockMovement {
  id        String @id @default(cuid())
  companyId String

  inventoryItemId String
  stockLocationId String
  type            StockMovementType
  quantity        Decimal           @db.Decimal(14, 3)
  /// What caused it: a GRN line, a transfer, a count session, an asset.
  refType         String?
  refId           String?
  reason          String?
  actorId         String?
  /// v2.9 C4 - which lot this movement drew on. Batches are a dimension of the
  /// existing ledger, not a parallel truth, so the movement rows stay the fact.
  stockBatchId    String?

  createdAt DateTime @default(now())

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  stockBatch    StockBatch?   @relation(fields: [stockBatchId], references: [id], onDelete: SetNull)

  @@index([inventoryItemId, stockLocationId, createdAt])
  @@index([companyId, createdAt])
  @@map("stock_movements")
}

/// Single-item location transfer (v2.4 cut); posts TRANSFER_OUT + TRANSFER_IN
/// ledger rows in one transaction.
model StockTransfer {
  id        String @id @default(cuid())
  companyId String

  inventoryItemId String
  fromLocationId  String
  toLocationId    String
  quantity        Decimal @db.Decimal(14, 3)
  note            String?
  movedById       String?

  createdAt DateTime @default(now())

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@map("stock_transfers")
}

// -----------------------------------------------------------------------------
// v2.5 Discovery, Hardware Detail & Work Orders (blueprint Part B + Vol III A).
// Discovery NEVER silently mutates assets: DiscoveredDevice is a staging row
// whose matchState is resolved by exact-serial auto-match or human review.
// AssetHealth is a derived cache (computedAt) - the domain health module is the
// authority. Hardware/OS/software rows are replaceable snapshots per asset.
// -----------------------------------------------------------------------------

enum DiscoverySource {
  MOCK
  AGENT
  INTUNE
}

enum DiscoveryMatchState {
  MATCHED
  PROPOSED
  CONFLICT
  UNMATCHED
  IGNORED
}

enum SmartStatus {
  HEALTHY
  WARNING
  FAILING
}

enum HealthGrade {
  EXCELLENT
  GOOD
  FAIR
  POOR
  CRITICAL
}

/// Latest discovered hardware snapshot for an asset (one row, replaced on ingest).
model HardwareProfile {
  id        String @id @default(cuid())
  companyId String
  assetId   String @unique

  manufacturer      String?
  modelName         String?
  cpu               String?
  cpuCores          Int?
  ramGb             Decimal?     @db.Decimal(8, 1)
  ramSlotsUsed      Int?
  ramSlotsTotal     Int?
  storageTotalGb    Decimal?     @db.Decimal(10, 1)
  storageFreeGb     Decimal?     @db.Decimal(10, 1)
  smartStatus       SmartStatus?
  batteryHealthPct  Int?
  batteryCycleCount Int?
  gpu               String?
  biosVersion       String?

  source           DiscoverySource
  lastDiscoveredAt DateTime        @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("hardware_profiles")
}

/// Latest OS + security-posture snapshot for an asset.
model OperatingSystemInfo {
  id        String @id @default(cuid())
  companyId String
  assetId   String @unique

  osName      String?
  osVersion   String?
  osBuild     String?
  osSupported Boolean?
  osActivated Boolean?
  lastBootAt  DateTime?

  diskEncrypted          Boolean?
  defenderEnabled        Boolean?
  firewallEnabled        Boolean?
  tpmPresent             Boolean?
  localAdminCount        Int?
  missingCriticalPatches Int?

  source           DiscoverySource
  lastDiscoveredAt DateTime        @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("operating_system_info")
}

/// Discovered software inventory rows; replaced wholesale per ingest.
model InstalledSoftware {
  id        String @id @default(cuid())
  companyId String
  assetId   String

  name        String
  version     String?
  publisher   String?
  installedAt DateTime?

  lastDiscoveredAt DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, name])
  @@index([companyId])
  @@map("installed_software")
}

/// Staging row for a device seen by discovery. Exact-serial matches auto-link;
/// everything else waits for a human (PROPOSED/CONFLICT) or stays UNMATCHED.
model DiscoveredDevice {
  id        String @id @default(cuid())
  companyId String

  externalId   String?
  serialNumber String?
  hostname     String?
  source       DiscoverySource
  matchState   DiscoveryMatchState @default(UNMATCHED)
  assetId      String?
  /// The raw ingest payload, kept verbatim for review and re-processing.
  payload      Json

  firstSeenAt  DateTime  @default(now())
  lastSeenAt   DateTime  @default(now())
  reviewedById String?
  reviewedAt   DateTime?

  asset Asset? @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([companyId, matchState])
  @@index([companyId, serialNumber])
  @@map("discovered_devices")
}

/// Derived health cache. The domain module is the authority; the sweep recomputes.
model AssetHealth {
  id        String @id @default(cuid())
  companyId String
  assetId   String @unique

  overall         Int
  grade           HealthGrade
  /// Per-sub-score breakdown: [{ key, score, weight }] - honest numbers.
  subScores       Json
  recommendations Json
  capped          Boolean     @default(false)
  computedAt      DateTime    @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([companyId, grade])
  @@map("asset_health")
}

enum WebhookDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
  DEAD
}

/// v2.6 A3 - an outbound webhook endpoint a tenant registered. The secret
/// signs every delivery (HMAC-SHA256 over the raw body); reads mask it.
/// v2.12 - platform-wide SMTP settings, editable from the operator console so
/// mail setup never requires a server login. Singleton row (id "default").
/// The password is AES-256-GCM encrypted - an SMTP key is a credential.
/// v2.15 - the AI provider, editable from the operator console like SMTP.
/// One row ('default'); the key is encrypted with the same scheme as MFA
/// secrets and never returned to a client.
model AiSettings {
  id              String  @id @default("default")
  provider        String  @default("mock")
  endpoint        String?
  model           String?
  apiKeyEncrypted String?

  updatedAt   DateTime @updatedAt
  updatedById String?

  @@map("ai_settings")
}

model MailSettings {
  id                String  @id @default("default")
  host              String
  port              Int     @default(587)
  secure            Boolean @default(false)
  username          String?
  passwordEncrypted String?
  fromAddress       String

  updatedAt   DateTime @updatedAt
  updatedById String?

  @@map("mail_settings")
}

model WebhookSubscription {
  id        String @id @default(cuid())
  companyId String

  url      String
  secret   String
  /// Event keys from the contracts catalogue, e.g. asset.created.
  events   String[]
  isActive Boolean  @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?

  deliveries WebhookDelivery[]

  @@index([companyId])
  @@map("webhook_subscriptions")
}

/// One delivery attempt lifecycle per event x subscription. Bounded retries
/// with backoff; DEAD after the cap - visible, never silently dropped.
model WebhookDelivery {
  id             String @id @default(cuid())
  companyId      String
  subscriptionId String

  event   String
  payload Json
  status  WebhookDeliveryStatus @default(PENDING)

  attempts       Int       @default(0)
  lastAttemptAt  DateTime?
  nextAttemptAt  DateTime?
  responseStatus Int?
  lastError      String?

  createdAt DateTime @default(now())

  subscription WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([companyId, createdAt])
  @@map("webhook_deliveries")
}

/// v2.6 A3 - the per-tenant SCIM bearer token (hash only; shown once).
/// v2.13 - the enrolment secret an agent installer carries. Company-wide and
/// rotatable: it can ONLY be exchanged for a device credential, never used to
/// read or write anything, so a copy leaking off one laptop cannot read the
/// estate. Only the SHA-256 hash is stored.
model AgentEnrolmentToken {
  id        String @id @default(cuid())
  companyId String @unique

  tokenHash   String
  createdAt   DateTime  @default(now())
  createdById String?
  lastUsedAt  DateTime?

  @@map("agent_enrolment_tokens")
}

/// v2.13 - one row per enrolled laptop. The credential is device-scoped: it may
/// report THIS machine's inventory and nothing else, which is why an agent
/// never needs an administrator's token.
model DeviceAgent {
  id        String @id @default(cuid())
  companyId String

  /// SHA-256 of the device credential handed back at enrolment.
  tokenHash    String  @unique
  /// Stable machine identity chosen at enrolment; reported inventory is pinned
  /// to it, so a compromised agent cannot impersonate another laptop.
  machineId    String
  hostname     String?
  serialNumber String?
  platform     String?
  agentVersion String?

  enrolledAt DateTime  @default(now())
  lastSeenAt DateTime?
  revokedAt  DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, machineId])
  @@index([companyId, revokedAt])
  @@map("device_agents")
}

model ScimToken {
  id        String @id @default(cuid())
  companyId String @unique

  tokenHash   String
  createdAt   DateTime  @default(now())
  createdById String?
  lastUsedAt  DateTime?

  @@map("scim_tokens")
}

/// Preventive maintenance recurrence; the sweep spawns REQUESTED work orders.
model MaintenanceSchedule {
  id        String @id @default(cuid())
  companyId String
  assetId   String

  title         String
  intervalDays  Int
  nextDueAt     DateTime
  lastCreatedAt DateTime?
  isActive      Boolean   @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([companyId, nextDueAt])
  @@map("maintenance_schedules")
}

// ─────────────────────────────────────────────────────────────────────────────
// v2.42 — Vendor catalog
//
// A vendor product is an OFFER, not stock. It is something a supplier says it
// will sell, at a price, until a date. It becomes inventory only after money
// moves and goods physically arrive, and the two must never be conflated: the
// entire point of a procurement trail is that "we paid for it" and "we have it"
// are different facts.
//
// Distinct from Quote, which already exists: a Quote is a priced response to one
// RFQ and dies with it. A VendorProduct stands on its own, is browsable, expires
// on its own clock, and can be compared against other vendors' offers before any
// request exists.
// ─────────────────────────────────────────────────────────────────────────────

enum VendorProductCondition {
  NEW
  REFURBISHED
  OPEN_BOX
  OTHER
}

/// Quality check result, derived from the counts rather than stated (v2.42).
enum QualityOutcome {
  PASSED
  PARTIAL
  FAILED
}

/// Where rejected units go. Both map to transitions the asset state machine
/// already allows out of RECEIVED, so no new asset status was invented.
enum RejectDisposition {
  RETURN_TO_VENDOR
  HOLD_DAMAGED
}

/// How a spec field is compared (v2.42).
enum SpecFieldType {
  TEXT
  NUMBER
  BOOLEAN
  ENUM
}

/// Which way a numeric requirement points.
enum NumericIntent {
  AT_LEAST
  AT_MOST
  EXACTLY
}

enum VendorProductStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  ACTIVE
  EXPIRING_SOON
  OUT_OF_STOCK
  EXPIRED
  PAUSED
  REJECTED
  DISCONTINUED
}

enum VendorProductReviewDecision {
  APPROVED
  REJECTED
  RETURNED_TO_VENDOR
  CORRECTION_REQUESTED
}

model VendorProduct {
  id        String @id @default(cuid())
  companyId String
  vendorId  String

  name          String
  categoryId    String
  subcategoryId String?
  brand         String?
  manufacturer  String?
  model         String?
  vendorSku     String?
  mpn           String?
  description   String?
  condition     VendorProductCondition @default(NEW)

  /// Category-shaped technical fields, validated against the spec template for
  /// the category. JSON for the same reason Asset.specs is: the field set
  /// differs per category and changes without a migration.
  specs Json?

  /// Validated at write time and stored as the video id alone - never raw embed
  /// markup from a vendor, which is somebody else's HTML running on our page.
  youtubeVideoId String?

  currency         String  @default("INR") @db.Char(3)
  unitPrice        Decimal @db.Decimal(14, 2)
  gstPercent       Decimal @default(0) @db.Decimal(5, 2)
  discount         Decimal @default(0) @db.Decimal(14, 2)
  shippingCost     Decimal @default(0) @db.Decimal(14, 2)
  installationCost Decimal @default(0) @db.Decimal(14, 2)
  otherCharges     Decimal @default(0) @db.Decimal(14, 2)

  /// Computed by the server on every write and stored. Stored because a
  /// comparison, an approval and a selection snapshot must agree to the paisa
  /// with what was shown, and recomputing it in three places is how they stop
  /// agreeing.
  landedCost Decimal @db.Decimal(14, 2)

  minOrderQuantity  Int     @default(1)
  availableQuantity Int     @default(0)
  paymentTerms      String?
  leadTimeDays      Int?
  warrantyMonths    Int?

  availableFrom  DateTime
  /// Required on purpose: an offer with no end date is a price nobody has
  /// promised to honour.
  availableUntil DateTime

  status VendorProductStatus @default(DRAFT)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?
  version     Int       @default(0)

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vendor      Vendor       @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  category    Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subcategory Subcategory? @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)

  images     VendorProductImage[]
  reviews    VendorProductReview[]
  selections ProcurementSelection[]

  @@index([companyId, status])
  @@index([companyId, vendorId])
  @@index([companyId, categoryId, status])
  @@index([companyId, availableUntil])
  @@map("vendor_products")
}

/// At least one image, at most three - both enforced in the service, because a
/// catalogue entry nobody can see the product in is not a catalogue entry.
model VendorProductImage {
  id              String @id @default(cuid())
  companyId       String
  vendorProductId String

  storageKey   String
  originalName String
  mimeType     String
  sizeBytes    Int
  sha256       String
  width        Int?
  height       Int?

  /// Exactly one per product, enforced on every write and on delete: removing
  /// the primary must promote another, never leave none.
  isPrimary Boolean @default(false)
  sortOrder Int     @default(0)

  createdAt    DateTime @default(now())
  uploadedById String?

  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vendorProduct VendorProduct @relation(fields: [vendorProductId], references: [id], onDelete: Cascade)

  @@unique([vendorProductId, sortOrder])
  @@index([companyId, vendorProductId])
  @@map("vendor_product_images")
}

/// Every review decision, kept as a list rather than one status field, so
/// "returned twice for the same missing specification" stays visible instead of
/// being overwritten by the next decision.
model VendorProductReview {
  id              String @id @default(cuid())
  companyId       String
  vendorProductId String

  decision     VendorProductReviewDecision
  comments     String?
  reviewedById String
  createdAt    DateTime                    @default(now())

  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vendorProduct VendorProduct @relation(fields: [vendorProductId], references: [id], onDelete: Cascade)
  reviewedBy    User          @relation("VendorProductReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@index([companyId, vendorProductId])
  @@map("vendor_product_reviews")
}

/// What was chosen, as it stood at the moment of choosing.
///
/// Deliberately a snapshot rather than a set of foreign keys: a vendor may edit
/// the price, the stock or the specification tomorrow, and an approval granted
/// on Tuesday must still show what Tuesday's approver actually approved.
model ProcurementSelection {
  id        String @id @default(cuid())
  companyId String

  vendorProductId   String
  vendorId          String
  purchaseRequestId String?
  assetRequestId    String?

  quantity Int

  currency         String  @db.Char(3)
  unitPrice        Decimal @db.Decimal(14, 2)
  gstPercent       Decimal @db.Decimal(5, 2)
  discount         Decimal @db.Decimal(14, 2)
  shippingCost     Decimal @db.Decimal(14, 2)
  installationCost Decimal @db.Decimal(14, 2)
  otherCharges     Decimal @db.Decimal(14, 2)
  landedCost       Decimal @db.Decimal(14, 2)
  /// landedCost * quantity, held so a total never has to be re-derived from a
  /// price that has since moved.
  totalCost        Decimal @db.Decimal(14, 2)

  productName            String
  brand                  String?
  model                  String?
  specsSnapshot          Json?
  warrantyMonths         Int?
  availableUntil         DateTime
  primaryImageStorageKey String?

  selectedById   String
  createdAt      DateTime  @default(now())
  deselectedAt   DateTime?
  deselectedById String?

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vendorProduct   VendorProduct    @relation(fields: [vendorProductId], references: [id], onDelete: Restrict)
  vendor          Vendor           @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  purchaseRequest PurchaseRequest? @relation(fields: [purchaseRequestId], references: [id], onDelete: SetNull)
  assetRequest    AssetRequest?    @relation(fields: [assetRequestId], references: [id], onDelete: SetNull)
  selectedBy      User             @relation("ProcurementSelector", fields: [selectedById], references: [id], onDelete: Restrict)

  @@index([companyId, vendorProductId])
  @@index([companyId, purchaseRequestId])
  @@index([companyId, assetRequestId])
  @@map("procurement_selections")
}
