{
  "expo": {
    "name": "PioAssets",
    "slug": "dalbeir-asset",
    "version": "0.3.46",
    "orientation": "default",
    "scheme": "techpioasset",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.techpio.asset",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan QR codes and barcodes, and photograph assets and invoices.",
        "NSFaceIDUsageDescription": "Unlock the app with Face ID."
      }
    },
    "android": {
      "package": "com.techpio.asset",
      "versionCode": 61,
      "permissions": [
        "CAMERA",
        "USE_BIOMETRIC",
        "POST_NOTIFICATIONS",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF",
        "monochromeImage": "./assets/monochrome-icon.png"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#001858",
          "dark": {
            "backgroundColor": "#001858"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Scan asset QR codes and barcodes, and capture invoices."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a saved photo of an asset label or a bill.",
          "cameraPermission": "Scan asset QR codes and barcodes, and capture invoices."
        }
      ],
      "expo-local-authentication",
      "expo-notifications",
      "expo-sqlite",
      "./plugins/with-android-shortcuts"
    ],
    "extra": {
      "apiUrl": "http://localhost:3001",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "786ccdc5-0012-4dd1-8dc3-84998ae38402"
      }
    },
    "owner": "dalbeir-asset",
    "icon": "./assets/icon.png",
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#001858"
    }
  }
}
