{
  "expo": {
    "name": "PioAssets",
    "slug": "dalbeir-asset",
    "version": "0.3.23",
    "orientation": "portrait",
    "scheme": "techpioasset",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.techpio.asset",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan QR codes and barcodes, and photograph assets and invoices.",
        "NSFaceIDUsageDescription": "Unlock the app with Face ID."
      }
    },
    "android": {
      "package": "com.techpio.asset",
      "versionCode": 38,
      "permissions": [
        "CAMERA",
        "USE_BIOMETRIC",
        "POST_NOTIFICATIONS",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Scan asset QR codes and barcodes, and capture invoices."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a saved photo of an asset label or a bill.",
          "cameraPermission": "Scan asset QR codes and barcodes, and capture invoices."
        }
      ],
      "expo-local-authentication",
      "expo-notifications",
      "expo-sqlite"
    ],
    "extra": {
      "apiUrl": "http://localhost:3001",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "786ccdc5-0012-4dd1-8dc3-84998ae38402"
      }
    },
    "owner": "dalbeir-asset",
    "icon": "./assets/icon.png",
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
