# ─────────────────────────────────────────────────────────────────────────────
# TechpioAsset — production environment.
#
# Copy to `.env.prod` on the server and fill in every value marked CHANGE_ME.
#   cp .env.prod.example .env.prod
#
# This one file is used two ways by docker-compose.prod.yml:
#   • variable substitution in the compose file (DOMAIN, PUBLIC_URL, POSTGRES_*)
#   • the api container's runtime environment (env_file)
#
# NEVER commit .env.prod — it is git-ignored and .dockerignored.
# Generate each 32+ char secret with:  openssl rand -base64 48
# ─────────────────────────────────────────────────────────────────────────────

# ── Public address ───────────────────────────────────────────────────────────
# Your domain (no scheme). Its DNS A record must point at this server.
DOMAIN=piotask.com
# Full public origin (scheme + domain). Baked into the web bundle at build time.
PUBLIC_URL=https://piotask.com

NODE_ENV=production
API_PORT=3001
API_URL=https://piotask.com
WEB_URL=https://piotask.com
# Only your own site may call the API from a browser.
CORS_ORIGINS=https://piotask.com

# ── Database (postgres container) ────────────────────────────────────────────
POSTGRES_USER=techpioasset
POSTGRES_PASSWORD=CHANGE_ME_db_password
POSTGRES_DB=techpioasset
# Host is the compose service name "postgres". Keep user/password/db in sync above.
DATABASE_URL=postgresql://techpioasset:CHANGE_ME_db_password@postgres:5432/techpioasset

# ── Redis (redis container) — powers queues, cache and rate limiting ─────────
REDIS_URL=redis://redis:6379
QUEUE_PROVIDER=bullmq
CACHE_PROVIDER=redis
RATE_LIMIT_STORAGE=redis

# ── Secrets (each ≥ 32 chars — openssl rand -base64 48) ──────────────────────
JWT_ACCESS_SECRET=CHANGE_ME_access_secret_min_32_chars
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret_min_32_chars
MFA_ENCRYPTION_KEY=CHANGE_ME_mfa_key_min_32_chars

# ── First super-admin (used once by `pnpm seed:admin`) ───────────────────────
SEED_ADMIN_EMAIL=admin@piotask.com
SEED_ADMIN_PASSWORD=CHANGE_ME_strong_admin_password
SEED_ADMIN_NAME=Site Administrator

# ── File storage — local volume by default (see uploads: volume) ─────────────
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=.local-storage

# ── AI document extraction — OFF by default (inert) ──────────────────────────
AI_PROVIDER=mock
AI_ENABLED=false
# To enable real Claude extraction later: AI_PROVIDER=anthropic, AI_ENABLED=true,
# and set ANTHROPIC_API_KEY.
# ANTHROPIC_API_KEY=

# ── Email — OFF by default (password-reset / invite emails will not send) ────
# To enable, set MAIL_PROVIDER=smtp and fill the SMTP_* values below.
MAIL_PROVIDER=mock
MAIL_FROM=TechpioAsset <no-reply@piotask.com>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=

# ── Background jobs (warranty/maintenance sweep) ─────────────────────────────
ENABLE_SCHEDULED_JOBS=true

LOG_LEVEL=info
